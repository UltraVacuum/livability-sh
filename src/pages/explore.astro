---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CITIES } from '../data/cities';
import { getDistricts, METRICS, type MetricKey } from '../data/districts';
import { computeCity } from '../lib/scoring';

// Build cross-city ranking data for all metrics
interface ExploreRow {
  cityName: string;
  cityKey: string;
  districtName: string;
  adcode: string;
  rawValue: number;
  score: number;
  unit: string;
}

interface DimensionData {
  metricKey: string;
  metricLabel: string;
  metricUnit: string;
  metricDescription: string;
  rows: ExploreRow[];
  stats: {
    mean: number;
    median: number;
    std: number;
    min: { name: string; value: number; cityKey: string; adcode: string };
    max: { name: string; value: number; cityKey: string; adcode: string };
    range: number;
    cv: number; // coefficient of variation
  };
}

// Compute all dimension data
const allDimensions: DimensionData[] = METRICS.map((metric) => {
  const rows: ExploreRow[] = [];
  for (const city of CITIES) {
    const scored = computeCity(getDistricts(city.key));
    for (const d of scored) {
      rows.push({
        cityName: city.name,
        cityKey: city.key,
        districtName: d.name,
        adcode: d.adcode,
        rawValue: d.metrics[metric.key as MetricKey].rawValue,
        score: d.metrics[metric.key as MetricKey].score,
        unit: metric.unit,
      });
    }
  }
  rows.sort((a, b) => b.score - a.score);

  const scores = rows.map((r) => r.score);
  const sorted = [...scores].sort((a, b) => a - b);
  const mean = scores.reduce((a, b) => a + b, 0) / scores.length;
  const median = sorted.length % 2 === 0
    ? (sorted[sorted.length / 2 - 1] + sorted[sorted.length / 2]) / 2
    : sorted[Math.floor(sorted.length / 2)];
  const std = Math.sqrt(scores.reduce((a, b) => a + (b - mean) ** 2, 0) / scores.length);
  const maxRow = rows[0];
  const minRow = rows[rows.length - 1];

  return {
    metricKey: metric.key,
    metricLabel: metric.label,
    metricUnit: metric.unit,
    metricDescription: metric.description,
    rows,
    stats: {
      mean,
      median,
      std,
      min: { name: minRow.districtName, value: minRow.score, cityKey: minRow.cityKey, adcode: minRow.adcode },
      max: { name: maxRow.districtName, value: maxRow.score, cityKey: maxRow.cityKey, adcode: maxRow.adcode },
      range: maxRow.score - minRow.score,
      cv: mean > 0 ? std / mean : 0,
    },
  };
});

const totalDistricts = allDimensions[0]?.rows.length ?? 0;
const totalDimensions = METRICS.length;
const totalCities = CITIES.length;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: '区县维度深探分析',
  description: `${totalCities}个城市 ${totalDistricts}个区县 在 ${totalDimensions} 个宜居维度的排名分布与统计摘要`,
  creator: { '@type': 'Organization', name: '宜居度' },
  keywords: ['区县排名', '维度分析', '宜居度', '城市数据'],
};

const pageTitle = '维度深探 · 跨城市区县宜居度深度分析';
const pageDesc = `选择维度（教育/医疗/经济/人口/交通/生活/智慧/数字），查看${totalCities}个城市${totalDistricts}个区县的排名分布、CSS柱状图、统计摘要（均值/中位数/标准差/极值），支持多维度叠加对比，一键切换维度深入分析。`;
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  path="/explore"
  keywords={[
    '维度分析',
    '区县排名',
    '教育排名',
    '医疗排名',
    '经济排名',
    '宜居度分析',
    '区县对比',
    '城市数据可视化',
    '上海区县排名',
    '银川区县排名',
  ]}
  jsonLd={jsonLd}
>
  <section class="container-page py-10 sm:py-14">
    <a href="/" class="text-sm text-ink-soft hover:text-accent">← 返回首页</a>
    <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">维度深探</h1>
    <p class="mt-3 max-w-2xl text-ink-soft">
      选择一个维度，深入查看 {totalCities} 个城市 {totalDistricts} 个区县的排名分布、统计摘要与可视化对比。或切换到「叠加模式」同时对比多个维度。
    </p>

    {/* ── 模式切换 ── */}
    <div class="mt-6 flex gap-2">
      <button type="button" id="mode-single" class="rounded-lg border border-accent bg-accent-soft px-4 py-2 text-sm font-medium text-accent transition">
        📊 单维度分析
      </button>
      <button type="button" id="mode-overlay" class="rounded-lg border border-line bg-surface px-4 py-2 text-sm font-medium text-ink-soft transition hover:text-ink">
        🔀 多维度叠加
      </button>
    </div>

    {/* ── 维度选择器 ── */}
    <div class="mt-4 flex flex-wrap gap-2" id="explore-tabs">
      {allDimensions.map((dim, idx) => (
        <button
          type="button"
          class={`explore-tab rounded-full border px-5 py-2.5 text-sm font-medium transition ${idx === 0 ? 'border-accent bg-accent-soft text-accent' : 'border-line bg-surface text-ink-soft hover:text-ink hover:border-accent'}`}
          data-dim={dim.metricKey}
        >
          {dim.metricLabel}
        </button>
      ))}
    </div>

    {/* ── 维度面板 ── */}
    {allDimensions.map((dim, idx) => {
      const top10 = dim.rows.slice(0, 10);
      const bottom5 = dim.rows.slice(-5).reverse();
      const maxBarScore = dim.rows[0]?.score ?? 100;
      const cityGroups = CITIES.map((city) => {
        const cityRows = dim.rows.filter((r) => r.cityKey === city.key);
        const cityScores = cityRows.map((r) => r.score);
        return {
          city,
          rows: cityRows,
          avg: cityScores.reduce((a, b) => a + b, 0) / (cityScores.length || 1),
          best: cityRows[0],
          worst: cityRows[cityRows.length - 1],
        };
      });

      return (
        <div class={`explore-panel mt-8 ${idx > 0 ? 'hidden' : ''}`} data-dim={dim.metricKey}>
          {/* ── 统计摘要卡片 ── */}
          <div class="grid gap-4 sm:grid-cols-3 lg:grid-cols-6">
            <div class="card p-4 text-center">
              <div class="text-xs text-ink-soft">均值</div>
              <div class="mt-1 text-xl font-bold text-ink">{dim.stats.mean.toFixed(1)}</div>
            </div>
            <div class="card p-4 text-center">
              <div class="text-xs text-ink-soft">中位数</div>
              <div class="mt-1 text-xl font-bold text-ink">{dim.stats.median.toFixed(1)}</div>
            </div>
            <div class="card p-4 text-center">
              <div class="text-xs text-ink-soft">标准差</div>
              <div class="mt-1 text-xl font-bold text-ink">{dim.stats.std.toFixed(1)}</div>
            </div>
            <div class="card p-4 text-center">
              <div class="text-xs text-ink-soft">极差</div>
              <div class="mt-1 text-xl font-bold text-ink">{dim.stats.range.toFixed(1)}</div>
            </div>
            <div class="card p-4 text-center">
              <div class="text-xs text-ink-soft">变异系数</div>
              <div class="mt-1 text-xl font-bold text-ink">{(dim.stats.cv * 100).toFixed(0)}%</div>
            </div>
            <div class="card p-4 text-center">
              <div class="text-xs text-ink-soft">区县数</div>
              <div class="mt-1 text-xl font-bold text-ink">{dim.rows.length}</div>
            </div>
          </div>

          {/* ── 极值高亮 ── */}
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <div class="card border-l-4 border-l-grade-a p-5">
              <div class="flex items-center gap-2">
                <span class="text-lg">🏆</span>
                <span class="text-xs font-medium uppercase tracking-wide text-ink-soft">最高分</span>
              </div>
              <div class="mt-2 flex items-baseline justify-between">
                <a href={`/${dim.stats.max.cityKey}/district/${dim.stats.max.adcode}`} class="text-lg font-bold text-accent hover:underline">
                  {dim.stats.max.name}
                </a>
                <span class="text-2xl font-bold text-grade-a">{dim.stats.max.value.toFixed(1)}</span>
              </div>
            </div>
            <div class="card border-l-4 border-l-grade-d p-5">
              <div class="flex items-center gap-2">
                <span class="text-lg">📉</span>
                <span class="text-xs font-medium uppercase tracking-wide text-ink-soft">最低分</span>
              </div>
              <div class="mt-2 flex items-baseline justify-between">
                <a href={`/${dim.stats.min.cityKey}/district/${dim.stats.min.adcode}`} class="text-lg font-bold text-ink-soft hover:text-accent">
                  {dim.stats.min.name}
                </a>
                <span class="text-2xl font-bold text-grade-d">{dim.stats.min.value.toFixed(1)}</span>
              </div>
            </div>
          </div>

          {/* ── Top 10 CSS 柱状图 ── */}
          <div class="card mt-6 overflow-hidden p-0">
            <div class="border-b border-line bg-surface-muted px-4 py-2.5 text-xs font-medium text-ink-soft">
              Top 10 — {dim.metricLabel}标准化评分
            </div>
            <div class="space-y-1 p-4">
              {top10.map((row, i) => {
                const barWidth = maxBarScore > 0 ? (row.score / maxBarScore) * 100 : 0;
                const isTop3 = i < 3;
                const colors = ['#0d9488', '#0f766e', '#115e59', '#14b8a6', '#2dd4bf', '#5eead4', '#99f6e4', '#ccfbf1', '#94a3b8', '#94a3b8'];
                return (
                  <div class="group flex items-center gap-3 rounded-lg px-2 py-1.5 transition hover:bg-surface-muted">
                    <span class={`w-7 shrink-0 text-center text-sm font-bold ${isTop3 ? 'text-accent' : 'text-ink-soft'}`}>
                      {i + 1}
                    </span>
                    <div class="w-24 shrink-0 truncate text-sm">
                      <a href={`/${row.cityKey}/district/${row.adcode}`} class="font-medium text-ink hover:text-accent">
                        {row.districtName}
                      </a>
                      <span class="ml-1 text-[10px] text-ink-soft">{row.cityName}</span>
                    </div>
                    <div class="min-w-0 flex-1">
                      <div class="h-6 overflow-hidden rounded-md bg-surface-muted">
                        <div
                          class="flex h-full items-center justify-end rounded-md transition-all duration-700"
                          style={`width:${barWidth}%; background:${colors[i]}`}
                        >
                          <span class="pr-2 text-[10px] font-bold text-white">{row.score.toFixed(0)}</span>
                        </div>
                      </div>
                    </div>
                    <div class="w-28 shrink-0 text-right text-xs text-ink-soft">
                      {row.rawValue.toLocaleString()} {row.unit}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>

          {/* ── 分布直方图 (CSS) ── */}
          <div class="card mt-6 p-5">
            <h3 class="text-sm font-semibold text-ink-soft">📊 分数分布</h3>
            <div class="mt-4 flex items-end gap-1" style="height:80px">
              {(() => {
                const bins = [0, 20, 40, 60, 80, 100];
                const binLabels = ['0-20', '20-40', '40-60', '60-80', '80-100'];
                const binCounts = binLabels.map((_, i) =>
                  dim.rows.filter((r) => r.score >= bins[i] && r.score < bins[i + 1]).length
                );
                const maxCount = Math.max(...binCounts, 1);
                const binColors = ['#dc2626', '#ea580c', '#ca8a04', '#16a34a', '#15803d'];
                return binLabels.map((label, i) => (
                  <div class="flex flex-1 flex-col items-center gap-1">
                    <span class="text-[10px] text-ink-soft">{binCounts[i]}</span>
                    <div
                      class="w-full rounded-t transition-all duration-700"
                      style={`height:${(binCounts[i] / maxCount) * 60}px; background:${binColors[i]}; min-height:2px`}
                    />
                    <span class="text-[10px] text-ink-soft">{label}</span>
                  </div>
                ));
              })()}
            </div>
          </div>

          {/* ── 城市对比分析 ── */}
          <div class="mt-6 grid gap-4 lg:grid-cols-2">
            {cityGroups.map((cg) => (
              <div class="card p-5">
                <h3 class="font-semibold text-ink">
                  {cg.city.name} · {dim.metricLabel}
                </h3>
                <div class="mt-3 flex items-center gap-4 text-sm">
                  <div>
                    <span class="text-ink-soft">平均分：</span>
                    <span class="font-bold">{cg.avg.toFixed(1)}</span>
                  </div>
                  <div>
                    <span class="text-ink-soft">区县数：</span>
                    <span class="font-bold">{cg.rows.length}</span>
                  </div>
                </div>
                {/* Inline mini bar chart for this city */}
                <div class="mt-4 space-y-1">
                  {cg.rows.map((r) => {
                    const w = maxBarScore > 0 ? (r.score / maxBarScore) * 100 : 0;
                    return (
                      <div class="flex items-center gap-2 text-xs">
                        <a href={`/${r.cityKey}/district/${r.adcode}`} class="w-16 shrink-0 truncate text-ink-soft hover:text-accent">
                          {r.districtName}
                        </a>
                        <div class="h-4 flex-1 overflow-hidden rounded bg-surface-muted">
                          <div class="h-full rounded bg-accent transition-all duration-500" style={`width:${w}%`} />
                        </div>
                        <span class="w-8 shrink-0 text-right font-medium">{r.score.toFixed(0)}</span>
                      </div>
                    );
                  })}
                </div>
              </div>
            ))}
          </div>

          {/* ── Bottom 5 待提升 ── */}
          <details class="mt-6">
            <summary class="cursor-pointer text-sm font-medium text-ink-soft hover:text-accent">
              ⚠️ 查看排名后 5 位（待提升区域）
            </summary>
            <div class="card mt-3 p-4">
              <div class="space-y-2">
                {bottom5.map((row, i) => (
                  <div class="flex items-center gap-3 text-sm">
                    <span class="w-7 text-center font-bold text-grade-d">{dim.rows.length - i}</span>
                    <a href={`/${row.cityKey}/district/${row.adcode}`} class="font-medium text-ink-soft hover:text-accent">
                      {row.districtName}
                    </a>
                    <span class="text-xs text-ink-soft">{row.cityName}</span>
                    <span class="ml-auto font-bold text-grade-d">{row.score.toFixed(1)}</span>
                  </div>
                ))}
              </div>
            </div>
          </details>

          {/* ── 全量排名表 ── */}
          <details class="mt-4">
            <summary class="cursor-pointer text-sm font-medium text-accent hover:underline">
              查看全部 {dim.rows.length} 个区县完整排名
            </summary>
            <div class="card mt-3 overflow-x-auto p-0">
              <table class="w-full text-sm">
                <thead>
                  <tr class="border-b border-line">
                    <th class="px-4 py-2.5 text-left text-xs font-medium text-ink-soft">排名</th>
                    <th class="px-4 py-2.5 text-left text-xs font-medium text-ink-soft">区县</th>
                    <th class="px-4 py-2.5 text-left text-xs font-medium text-ink-soft">城市</th>
                    <th class="px-4 py-2.5 text-right text-xs font-medium text-ink-soft">原始值</th>
                    <th class="px-4 py-2.5 text-right text-xs font-medium text-ink-soft">评分</th>
                    <th class="px-4 py-2.5 text-left text-xs font-medium text-ink-soft">分布</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-line">
                  {dim.rows.map((row, i) => {
                    const w = maxBarScore > 0 ? (row.score / maxBarScore) * 100 : 0;
                    return (
                      <tr class="transition hover:bg-surface-muted">
                        <td class="px-4 py-2 font-medium text-ink-soft">{i + 1}</td>
                        <td class="px-4 py-2">
                          <a href={`/${row.cityKey}/district/${row.adcode}`} class="font-medium text-ink hover:text-accent">
                            {row.districtName}
                          </a>
                        </td>
                        <td class="px-4 py-2 text-ink-soft">{row.cityName}</td>
                        <td class="px-4 py-2 text-right text-ink-soft">{row.rawValue.toLocaleString()} {row.unit}</td>
                        <td class="px-4 py-2 text-right font-semibold">{row.score.toFixed(1)}</td>
                        <td class="px-4 py-2">
                          <div class="h-2 w-20 overflow-hidden rounded-full bg-surface-muted">
                            <div class="h-full rounded-full bg-accent" style={`width:${w}%`} />
                          </div>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </details>
        </div>
      );
    })}

    {/* ── 维度切换 JS (with URL param persistence) ── */}
    <script is:inline>
      (function () {
        const tabs = document.querySelectorAll('.explore-tab');
        const panels = document.querySelectorAll('.explore-panel');

        function activateDim(dim) {
          tabs.forEach((t) => {
            if (t.getAttribute('data-dim') === dim) {
              t.classList.remove('border-line', 'bg-surface', 'text-ink-soft');
              t.classList.add('border-accent', 'bg-accent-soft', 'text-accent');
            } else {
              t.classList.remove('border-accent', 'bg-accent-soft', 'text-accent');
              t.classList.add('border-line', 'bg-surface', 'text-ink-soft');
            }
          });
          panels.forEach((p) => {
            if (p.getAttribute('data-dim') === dim) {
              p.classList.remove('hidden');
            } else {
              p.classList.add('hidden');
            }
          });
        }

        function updateUrl(dim) {
          const url = new URL(window.location);
          url.searchParams.set('dim', dim);
          window.history.pushState({ dim }, '', url);
        }

        tabs.forEach((tab) => {
          tab.addEventListener('click', function () {
            const dim = this.getAttribute('data-dim');
            activateDim(dim);
            updateUrl(dim);
            window.scrollTo({ top: tabs[0].offsetTop - 100, behavior: 'smooth' });
          });
        });

        // ── Restore from URL on load ──
        const params = new URLSearchParams(window.location.search);
        const urlDim = params.get('dim');
        if (urlDim) {
          const validDim = Array.from(tabs).some((t) => t.getAttribute('data-dim') === urlDim);
          if (validDim) {
            activateDim(urlDim);
          }
        }

        // ── Handle browser back/forward ──
        window.addEventListener('popstate', function (e) {
          const dim = (e.state && e.state.dim) || new URLSearchParams(window.location.search).get('dim');
          if (dim) {
            activateDim(dim);
          }
        });
      })();
    </script>

    {/* ── 多维度叠加对比面板 ── */}
    <div id="overlay-panel" class="mt-8 hidden">
      <div class="card p-5">
        <h3 class="text-sm font-semibold text-ink">选择 2-3 个维度进行叠加对比（可保存为图片分享）</h3>
        <p class="mt-1 text-xs text-ink-soft">选择维度后，各区县在所选维度上的得分将以不同颜色柱状图叠加展示</p>
        <div class="mt-4 flex flex-wrap gap-2" id="overlay-dim-selector">
          {allDimensions.map((dim) => (
            <button
              type="button"
              class="overlay-dim-btn rounded-full border border-line bg-surface px-4 py-2 text-sm font-medium text-ink-soft transition hover:border-accent"
              data-dim={dim.metricKey}
            >
              {dim.metricLabel}
            </button>
          ))}
        </div>
        <div class="mt-3 text-xs text-ink-soft">
          已选 <span id="overlay-count">0</span> 个维度（最少 2，最多 3）
        </div>
      </div>

      {/* Overlay radar + table */}
      <div class="mt-6 grid gap-6 lg:grid-cols-[400px_1fr]">
        <div class="card flex flex-col items-center p-5">
          <h3 class="mb-3 text-sm font-semibold text-ink-soft">多维度叠加雷达图</h3>
          <svg id="overlay-radar" width="360" height="360" viewBox="0 0 360 360" role="img" aria-label="多维度叠加雷达图">
          </svg>
          <div id="overlay-legend" class="mt-3 flex flex-wrap justify-center gap-3 text-xs"></div>
          <button
            type="button"
            id="save-radar-btn"
            class="mt-4 rounded-lg border border-accent bg-accent-soft px-4 py-2 text-xs font-medium text-accent transition hover:bg-accent hover:text-white"
          >
            💾 保存为图片（PNG）
          </button>
        </div>
        <div id="overlay-content" class="space-y-4"></div>
      </div>
    </div>

    {/* ── Overlay mode data + script ── */}
    <script is:inline define:vars={{
      overlayDimData: allDimensions.map(d => ({
        key: d.metricKey,
        label: d.metricLabel,
        unit: d.metricUnit,
        rows: d.rows.map(r => ({ name: r.districtName, city: r.cityName, cityKey: r.cityKey, adcode: r.adcode, score: r.score, rawValue: r.rawValue })),
      })),
      overlayDistrictNames: allDimensions[0]?.rows.map(r => ({ name: r.districtName, city: r.cityName, cityKey: r.cityKey, adcode: r.adcode })) ?? [],
    }}>
      (function () {
        var OVERLAY_COLORS = ['#0d9488', '#dc2626', '#7c3aed'];
        var selectedDims = [];
        var btns = document.querySelectorAll('.overlay-dim-btn');
        var countEl = document.getElementById('overlay-count');
        var contentEl = document.getElementById('overlay-content');
        var svg = document.getElementById('overlay-radar');
        var legend = document.getElementById('overlay-legend');
        var SIZE = 360, cx = SIZE / 2, cy = SIZE / 2, R = SIZE / 2 - 48;

        function pointAt(i, r, total) {
          var angle = -Math.PI / 2 + (i * 2 * Math.PI) / total;
          return [cx + r * Math.cos(angle), cy + r * Math.sin(angle)];
        }

        function updateSelector() {
          btns.forEach(function (btn) {
            var dim = btn.getAttribute('data-dim');
            if (selectedDims.indexOf(dim) >= 0) {
              btn.classList.remove('border-line', 'bg-surface', 'text-ink-soft');
              btn.classList.add('border-accent', 'bg-accent-soft', 'text-accent');
            } else {
              btn.classList.add('border-line', 'bg-surface', 'text-ink-soft');
              btn.classList.remove('border-accent', 'bg-accent-soft', 'text-accent');
            }
          });
          countEl.textContent = selectedDims.length;
          renderOverlay();
          // ── URL param persistence for overlay dims ──
          var url = new URL(window.location);
          if (selectedDims.length > 0) {
            url.searchParams.set('dims', selectedDims.join(','));
          } else {
            url.searchParams.delete('dims');
          }
          window.history.replaceState(null, '', url);
        }

        btns.forEach(function (btn) {
          btn.addEventListener('click', function () {
            var dim = this.getAttribute('data-dim');
            var idx = selectedDims.indexOf(dim);
            if (idx >= 0) {
              selectedDims.splice(idx, 1);
            } else {
              if (selectedDims.length >= 3) return;
              selectedDims.push(dim);
            }
            updateSelector();
          });
        });

        function renderOverlay() {
          if (selectedDims.length < 2) {
            contentEl.innerHTML = '<div class="card p-5"><p class="text-sm text-ink-soft">请至少选择 2 个维度开始对比</p></div>';
            svg.innerHTML = '';
            legend.innerHTML = '';
            return;
          }

          // Get districts that have data for all selected dims
          var dimData = selectedDims.map(function (dk) {
            return overlayDimData.find(function (d) { return d.key === dk; });
          });

          // Build district lookup: adcode → { name, city, scores: {dim: score} }
          var districtMap = {};
          dimData.forEach(function (dd) {
            dd.rows.forEach(function (r) {
              if (!districtMap[r.adcode]) {
                districtMap[r.adcode] = { name: r.name, city: r.city, cityKey: r.cityKey, adcode: r.adcode, scores: {} };
              }
              districtMap[r.adcode].scores[dd.key] = r.score;
            });
          });
          var districts = Object.values(districtMap);

          // ── Radar chart ──
          var n = districts.length;
          var html = '';
          // Grid rings
          [0.25, 0.5, 0.75, 1].forEach(function (ring) {
            var pts = [];
            for (var i = 0; i < n; i++) {
              var p = pointAt(i, R * ring, n);
              pts.push(p[0] + ',' + p[1]);
            }
            html += '<polygon points="' + pts.join(' ') + '" fill="' + (ring === 1 ? '#f8fafc' : 'none') + '" stroke="#e2e8f0" stroke-width="1"/>';
          });
          // Axis labels (district names)
          districts.forEach(function (d, i) {
            var p = pointAt(i, R, n);
            var lp = pointAt(i, R + 22, n);
            html += '<line x1="' + cx + '" y1="' + cy + '" x2="' + p[0] + '" y2="' + p[1] + '" stroke="#e2e8f0" stroke-width="1"/>';
            var shortName = d.name.length > 4 ? d.name.substring(0, 3) + '…' : d.name;
            html += '<text x="' + lp[0] + '" y="' + lp[1] + '" text-anchor="middle" dominant-baseline="middle" font-size="9" fill="#475569">' + shortName + '</text>';
          });
          // Each dimension as a polygon
          dimData.forEach(function (dd, di) {
            var color = OVERLAY_COLORS[di];
            var pts = districts.map(function (d, i) {
              var v = (d.scores[dd.key] || 0) / 100;
              var p = pointAt(i, v * R, n);
              return p[0] + ',' + p[1];
            }).join(' ');
            html += '<polygon points="' + pts + '" fill="' + color + '" fill-opacity="0.1" stroke="' + color + '" stroke-width="2" stroke-linejoin="round"/>';
          });
          svg.innerHTML = html;

          // Legend
          var lh = '';
          dimData.forEach(function (dd, di) {
            lh += '<span class="flex items-center gap-1.5"><span class="inline-block h-3 w-3 rounded-full" style="background:' + OVERLAY_COLORS[di] + '"></span>' + dd.label + '</span>';
          });
          legend.innerHTML = lh;

          // ── Comparison table ──
          var html2 = '<div class="card overflow-x-auto p-0"><table class="w-full text-sm"><thead><tr class="border-b border-line">';
          html2 += '<th class="px-4 py-3 text-left text-xs font-medium text-ink-soft">区县</th>';
          dimData.forEach(function (dd, di) {
            html2 += '<th class="px-4 py-3 text-left"><span class="inline-block h-3 w-3 rounded-full align-middle" style="background:' + OVERLAY_COLORS[di] + '"></span><span class="ml-1 font-semibold text-ink">' + dd.label + '</span></th>';
          });
          html2 += '<th class="px-4 py-3 text-left text-xs font-medium text-ink-soft">差异</th></tr></thead><tbody class="divide-y divide-line">';

          // Sort districts by average score of selected dims
          districts.sort(function (a, b) {
            var avgA = selectedDims.reduce(function (s, dk) { return s + (a.scores[dk] || 0); }, 0) / selectedDims.length;
            var avgB = selectedDims.reduce(function (s, dk) { return s + (b.scores[dk] || 0); }, 0) / selectedDims.length;
            return avgB - avgA;
          });

          districts.forEach(function (d) {
            html2 += '<tr class="transition hover:bg-surface-muted">';
            html2 += '<td class="px-4 py-2"><a href="/' + d.cityKey + '/district/' + d.adcode + '" class="font-medium text-ink hover:text-accent">' + d.name + '</a><span class="ml-1 text-[10px] text-ink-soft">' + d.city + '</span></td>';
            var scores = selectedDims.map(function (dk) { return d.scores[dk] || 0; });
            var maxS = Math.max.apply(null, scores);
            var minS = Math.min.apply(null, scores);
            selectedDims.forEach(function (dk) {
              var s = d.scores[dk] || 0;
              var isMax = s === maxS && (maxS - minS) > 0.1;
              html2 += '<td class="px-4 py-2"><div class="h-2 w-16 overflow-hidden rounded-full bg-surface-muted"><div class="h-full rounded-full" style="width:' + s + '%; background:' + OVERLAY_COLORS[selectedDims.indexOf(dk)] + '"></div></div><span class="mt-0.5 block text-xs ' + (isMax ? 'font-bold text-ink' : 'text-ink-soft') + '">' + s.toFixed(0) + (isMax ? ' ⬆️' : '') + '</span></td>';
            });
            var diff = maxS - minS;
            var diffColor = diff > 30 ? '#dc2626' : diff > 15 ? '#ea580c' : '#64748b';
            html2 += '<td class="px-4 py-2 text-sm" style="color:' + diffColor + '">' + diff.toFixed(1) + '</td>';
            html2 += '</tr>';
          });
          html2 += '</tbody></table></div>';

          // ── Bar chart overlay ──
          html2 += '<div class="card p-5"><h3 class="text-sm font-semibold text-ink-soft">📊 维度叠加柱状图 — Top 10</h3><div class="mt-4 space-y-2">';
          districts.slice(0, 10).forEach(function (d) {
            html2 += '<div class="flex items-center gap-2"><span class="w-16 shrink-0 truncate text-xs text-ink-soft">' + d.name + '</span>';
            html2 += '<div class="flex h-6 flex-1 overflow-hidden rounded-lg bg-surface-muted">';
            selectedDims.forEach(function (dk, di) {
              var s = d.scores[dk] || 0;
              html2 += '<div class="flex h-full items-center justify-center transition-all duration-500" style="width:' + (s / (selectedDims.length * 100) * 100) + '%; background:' + OVERLAY_COLORS[di] + '" title="' + overlayDimData.find(function(x){return x.key===dk}).label + ': ' + s.toFixed(0) + '"><span class="text-[8px] font-bold text-white">' + (s > 20 ? s.toFixed(0) : '') + '</span></div>';
            });
            html2 += '</div></div>';
          });
          html2 += '</div></div>';

          contentEl.innerHTML = html2;
        }

        // ── Mode switching ──
        var btnSingle = document.getElementById('mode-single');
        var btnOverlay = document.getElementById('mode-overlay');
        var singlePanels = document.querySelectorAll('.explore-panel');
        var tabsRow = document.getElementById('explore-tabs');
        var overlayPanel = document.getElementById('overlay-panel');

        function switchToOverlay() {
          btnOverlay.classList.remove('border-line', 'bg-surface', 'text-ink-soft');
          btnOverlay.classList.add('border-accent', 'bg-accent-soft', 'text-accent');
          btnSingle.classList.remove('border-accent', 'bg-accent-soft', 'text-accent');
          btnSingle.classList.add('border-line', 'bg-surface', 'text-ink-soft');
          singlePanels.forEach(function (p) { p.classList.add('hidden'); });
          tabsRow.classList.add('hidden');
          overlayPanel.classList.remove('hidden');
          renderOverlay();
          var url = new URL(window.location);
          url.searchParams.set('mode', 'overlay');
          window.history.replaceState(null, '', url);
        }

        function switchToSingle() {
          btnSingle.classList.remove('border-line', 'bg-surface', 'text-ink-soft');
          btnSingle.classList.add('border-accent', 'bg-accent-soft', 'text-accent');
          btnOverlay.classList.remove('border-accent', 'bg-accent-soft', 'text-accent');
          btnOverlay.classList.add('border-line', 'bg-surface', 'text-ink-soft');
          singlePanels.forEach(function (p) { p.classList.remove('hidden'); });
          var firstPanel = singlePanels[0];
          if (firstPanel) firstPanel.classList.remove('hidden');
          tabsRow.classList.remove('hidden');
          overlayPanel.classList.add('hidden');
          var url = new URL(window.location);
          url.searchParams.set('mode', 'single');
          url.searchParams.delete('dims');
          window.history.replaceState(null, '', url);
        }

        btnSingle.addEventListener('click', switchToSingle);
        btnOverlay.addEventListener('click', switchToOverlay);

        // ── Restore overlay mode + dims from URL on load ──
        var urlParams = new URLSearchParams(window.location.search);
        var urlMode = urlParams.get('mode');
        var urlDims = urlParams.get('dims');
        if (urlMode === 'overlay') {
          if (urlDims) {
            selectedDims = urlDims.split(',').filter(function (d) {
              return overlayDimData.some(function (dd) { return dd.key === d; });
            }).slice(0, 3);
          }
          switchToOverlay();
          if (selectedDims.length >= 2) updateSelector();
        } else {
          renderOverlay();
        }
      })();
    </script>

    {/* ── 保存雷达图为 PNG（SVG → Canvas 导出） ── */}
    <script is:inline>
      (function () {
        var btn = document.getElementById('save-radar-btn');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var svg = document.getElementById('overlay-radar');
          var legend = document.getElementById('overlay-legend');
          // 未选够维度时雷达图为空（网格环 4 个 polygon + 数据多边形 ≥2）
          if (!svg || svg.querySelectorAll('polygon').length < 6) {
            alert('请先在叠加模式中选择至少 2 个维度，再保存图片');
            return;
          }
          var svgStr = new XMLSerializer().serializeToString(svg);
          var scale = 2; // 2x 分辨率，导出更清晰
          var W = 360, H = 360, PAD_TOP = 64, PAD_BOTTOM = 56;
          var canvasW = W * scale, canvasH = (H + PAD_TOP + PAD_BOTTOM) * scale;
          var img = new Image();
          img.onload = function () {
            var canvas = document.createElement('canvas');
            canvas.width = canvasW;
            canvas.height = canvasH;
            var ctx = canvas.getContext('2d');
            // 白底 + 标题 + 水印
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, canvasW, canvasH);
            ctx.fillStyle = '#0f172a';
            ctx.font = 'bold ' + 20 * scale + 'px system-ui, -apple-system, sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText('城市宜居度 · 多维度叠加对比', canvasW / 2, 34 * scale);
            ctx.fillStyle = '#64748b';
            ctx.font = 12 * scale + 'px system-ui, -apple-system, sans-serif';
            ctx.fillText('数据来源：yijudu.com（基于公开统计与 POI 数据）', canvasW / 2, 56 * scale);
            ctx.drawImage(img, 0, PAD_TOP * scale, W * scale, H * scale);
            // 图例（从页面 legend 复制文本+色点）
            var legendY = (PAD_TOP + H + 24) * scale;
            var items = legend ? legend.querySelectorAll('span') : [];
            var totalText = Array.prototype.map.call(items, function (s) { return s.textContent.trim(); }).join('   ');
            ctx.fillStyle = '#334155';
            ctx.font = 12 * scale + 'px system-ui, -apple-system, sans-serif';
            ctx.fillText(totalText || '维度叠加雷达图', canvasW / 2, legendY);
            var a = document.createElement('a');
            a.download = 'yijudu-overlay-radar.png';
            a.href = canvas.toDataURL('image/png');
            a.click();
          };
          img.onerror = function () { alert('图片导出失败，请重试'); };
          img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svgStr);
        });
      })();
    </script>

    {/* ── 底部导航 ── */}
    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/rankings" class="rounded-xl bg-accent px-5 py-2.5 text-sm font-medium text-white transition hover:opacity-90">
        🏆 查看排行榜 →
      </a>
      <a href="/compare" class="rounded-xl border border-line bg-surface px-5 py-2.5 text-sm font-medium text-ink-soft transition hover:text-ink">
        📊 去对比区县
      </a>
      <a href="/" class="rounded-xl border border-line bg-surface px-5 py-2.5 text-sm font-medium text-ink-soft transition hover:text-ink">
        回首页
      </a>
    </div>
  </section>
</BaseLayout>
