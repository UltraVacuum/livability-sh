        <span class="text-xs text-rose-600">（市级数据，来源：<a href={cityVolunteer.sourceUrl} class="underline">{cityVolunteer.source}</a>）</span>
      </div>
    )}

    {cityRenewable && (
      <div class="mt-3 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
        ⚡ {city.name}{cityRenewable.year}年可再生能源与绿色设施：
        {city.key === 'shanghai' ? <>光伏累计装机 <strong>{cityRenewable.totalPvCapacity}万千瓦</strong>（+{cityRenewable.pvGrowthRate}%），新增 <strong>{cityRenewable.newPvCapacity}万千瓦</strong>，充电设施 <strong>{cityRenewable.totalChargingGuns}万个</strong>（站 <strong>{cityRenewable.totalChargingStations.toLocaleString()}</strong> 座），新能源汽车 <strong>{cityRenewable.newEnergyVehicles}万辆</strong>，绿色建筑占比 <strong>{cityRenewable.greenBuildingRatio}%</strong>，超低能耗 <strong>{cityRenewable.ultraLowEnergyArea}万㎡</strong></> : <>可再生能源发电 <strong>{cityRenewable.renewableGeneration}亿千瓦时</strong>（占比 <strong>{cityRenewable.renewableShare}%</strong>），充电桩 <strong>{cityRenewable.totalChargingGuns}万个</strong>，新能源汽车 <strong>{cityRenewable.newEnergyVehicles}万辆</strong></>}
        <span class="text-xs text-emerald-600">（市级数据，来源：<a href={cityRenewable.sourceUrl} class="underline">{cityRenewable.source}</a>）</span>
      </div>
    )}

    {cityDigitalLifeData && (
      <div class="mt-3 rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800">
        📱 {city.name}{cityDigitalLifeData.year}年数字生活：
        {city.key === 'shanghai' ? <>电商交易额 <strong>{cityDigitalLifeData.ecommerceTotal}万亿</strong>元（+15.2%），网络购物 <strong>{cityDigitalLifeData.onlineShopping}万亿</strong>元，5G用户 <strong>{cityDigitalLifeData.fiveGUsers}万</strong>，5G基站 <strong>{cityDigitalLifeData.fiveGStations}万</strong>个，宽带 <strong>{cityDigitalLifeData.avgBroadband}Mbps</strong>，网约车约 <strong>{cityDigitalLifeData.rideHailingTotal}万</strong>辆</> : <>移动电话 <strong>{cityDigitalLifeData.mobileUsers}万</strong>户，宽带 <strong>{cityDigitalLifeData.broadbandUsers}万</strong>户，网约车约 <strong>{cityDigitalLifeData.rideHailingTotal}万</strong>辆</>}
        <span class="text-xs text-blue-600">（市级数据，来源：<a href={cityDigitalLifeData.sourceUrl} class="underline">{cityDigitalLifeData.source}</a>）</span>
      </div>
    )}

    {cityAgriculture && (
      <div class="mt-3 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">
        🌾 {city.name}{cityAgriculture.year}年农业与乡村振兴：
        农林牧渔业总产值 <strong>{cityAgriculture.totalAgriOutput}亿</strong>元
        ，粮食产量 <strong>{cityAgriculture.grainOutput}万吨</strong>
        {cityAgriculture.milkOutput ? `，牛奶 ${cityAgriculture.milkOutput}万吨` : ''}
        {cityAgriculture.meatOutput ? `，肉产量 ${cityAgriculture.meatOutput}万吨` : ''}
        ，乡村振兴示范村 <strong>{cityAgriculture.demonstrationVillages}</strong> 个
        ，美丽乡村 <strong>{cityAgriculture.beautifulVillages}</strong> 个
        ，农村居民收入 <strong>{cityAgriculture.ruralIncome.toLocaleString()}元</strong>（+{cityAgriculture.incomeGrowth}%）
        <span class="text-xs text-green-600">（市级数据，来源：<a href={cityAgriculture.sourceUrl} class="underline">{cityAgriculture.source}</a>）</span>
      </div>
    )}

    {cityEmpService && (
      <div class="mt-3 rounded-lg border border-cyan-200 bg-cyan-50 px-4 py-3 text-sm text-cyan-800">
        💼 {city.name}{cityEmpService.year}年就业服务与人才市场：
        城镇新增就业 <strong>{cityEmpService.newJobs}万</strong>人
        ，失业人员再就业 <strong>{cityEmpService.reemployed}万</strong>人
        ，职业培训 <strong>{cityEmpService.vocationalTraining}万</strong>人次
        ，创业帮扶 <strong>{cityEmpService.entrepreneurshipSupport.toLocaleString()}</strong>户
        ，就业服务站点 <strong>{cityEmpService.jobServiceStations}</strong>个
        ，人才公寓 <strong>{cityEmpService.talentApartments.toLocaleString()}</strong>套
        {cityEmpService.overseasTalent ? `，海外人才定居 ${cityEmpService.overseasTalent}万人/年` : ''}
        ，登记失业率 <strong>{cityEmpService.registeredUnemploymentRate}%</strong>
        <span class="text-xs text-cyan-600">（市级数据，来源：<a href={cityEmpService.sourceUrl} class="underline">{cityEmpService.source}</a>）</span>
      </div>
    )}

    {cityDisaster && (
      <div class="mt-3 rounded-lg border border-orange-200 bg-orange-50 px-4 py-3 text-sm text-orange-800">
        🌪️ {city.name}{cityDisaster.year}年气象灾害风险与应急：
        {city.key === 'shanghai' ? <>高温日数 <strong>{cityDisaster.highTempDays}天</strong>，暴雨预警 <strong>{cityDisaster.rainstormWarnings}次</strong>，台风影响 <strong>{cityDisaster.typhoonTimes}次</strong>，雷电预警 <strong>{cityDisaster.lightningWarnings}次</strong>，直接经济损失 <strong>{cityDisaster.directLoss}亿</strong>元，防汛墙 <strong>{cityDisaster.floodWalls}km</strong>，排水泵站 <strong>{cityDisaster.drainagePumps}座</strong>，气象站 <strong>{cityDisaster.weatherStations}</strong>个</> : <>高温日数 <strong>{cityDisaster.highTempDays}天</strong>，沙尘暴 <strong>{cityDisaster.sandstormDays}天</strong>，暴雨预警 <strong>{cityDisaster.rainstormWarnings}次</strong>，冰雹 <strong>{cityDisaster.hailTimes}次</strong>，直接经济损失 <strong>{cityDisaster.directLoss}亿</strong>元，气象站 <strong>{cityDisaster.weatherStations}</strong>个</>}
        ，预警覆盖率 <strong>{cityDisaster.warningCoverage}%</strong>
        <span class="text-xs text-orange-600">（市级数据，来源：<a href={cityDisaster.sourceUrl} class="underline">{cityDisaster.source}</a>）</span>
      </div>
    )}

    {cityAccessibility && (
      <div class="mt-3 rounded-lg border border-indigo-200 bg-indigo-50 px-4 py-3 text-sm text-indigo-800">
        ♿ {city.name}{cityAccessibility.year}年无障碍设施建设：
        无障碍设施点位 <strong>{cityAccessibility.totalFacilities}万</strong>个
        ，缘石坡道 <strong>{cityAccessibility.curbRamps}万</strong>处
        ，无障碍公厕 <strong>{cityAccessibility.accessibleToilets}</strong>座
        ，无障碍电梯 <strong>{cityAccessibility.accessibleElevators.toLocaleString()}</strong>部
        ，盲道 <strong>{cityAccessibility.tactilePaving}km</strong>
        ，导盲犬 <strong>{cityAccessibility.guideDogs}</strong>条
        ，低地板公交 <strong>{cityAccessibility.lowFloorBuses}</strong>辆
        {cityAccessibility.accessibleTaxis ? `，无障碍出租车 ${cityAccessibility.accessibleTaxis}辆` : ''}
        ，家庭无障碍改造 <strong>{cityAccessibility.homeRetrofit}万</strong>户
        ，网站无障碍达标率 <strong>{cityAccessibility.webAccessibilityRate}%</strong>
        <span class="text-xs text-indigo-600">（市级数据，来源：<a href={cityAccessibility.sourceUrl} class="underline">{cityAccessibility.source}</a>）</span>
      </div>
    )}

    {cityGovService && (
      <div class="mt-3 rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800">
        🖥️ {city.name}{cityGovService.year}年互联网+政务服务（{city.key === 'shanghai' ? '一网通办' : 'i银川'}）：
        注册用户 <strong>{cityGovService.registeredUsers}</strong>万人
        ，接入事项 <strong>{cityGovService.totalItems}</strong>项
        ，全程网办率 <strong>{cityGovService.onlineRate}%</strong>
        ，年办件 <strong>{cityGovService.annualTransactions}</strong>亿件
        ，{city.key === 'shanghai' ? `“随申办”月活 <strong>${cityGovService.appMonthlyActive}</strong>万` : `“i银川”月活 <strong>${cityGovService.appMonthlyActive}</strong>万`}
        ，电子证照 <strong>{cityGovService.eLicenseTypes}</strong>类
        ，“一件事”集成 <strong>{cityGovService.integratedServices}</strong>项
        ，跨省通办 <strong>{cityGovService.crossProvinceItems}</strong>项
        ，好评率 <strong>{cityGovService.satisfaction}%</strong>
        <span class="text-xs text-blue-600">（市级数据，来源：<a href={cityGovService.sourceUrl} class="underline">{cityGovService.source}</a>）</span>
      </div>
    )}

    {cityLibrary && (
      <div class="mt-3 rounded-lg border border-teal-200 bg-teal-50 px-4 py-3 text-sm text-teal-800">
        📚 {city.name}{cityLibrary.year}年公共图书馆服务：
        公共图书馆 <strong>{cityLibrary.totalBranches}</strong>座
        ，总藏书 <strong>{cityLibrary.totalCollections}</strong>万册
        ，年流通 <strong>{cityLibrary.annualVisitors}</strong>万人次
        ，年借阅 <strong>{cityLibrary.annualLoans}</strong>万册次
        ，分馆/服务点 <strong>{cityLibrary.servicePoints}</strong>个
        ，24h自助图书馆 <strong>{cityLibrary.selfServiceKiosks}</strong>台
        ，人均藏书 <strong>{cityLibrary.perCapitaBooks}</strong>册
        ，数字资源访问 <strong>{cityLibrary.digitalAccess}</strong>亿人次
        <span class="text-xs text-teal-600">（市级数据，来源：<a href={cityLibrary.sourceUrl} class="underline">{cityLibrary.source}</a>）</span>
      </div>
    )}

    {cityFuneral && (
      <div class="mt-3 rounded-lg border border-stone-300 bg-stone-50 px-4 py-3 text-sm text-stone-800">
        ⚱️ {city.name}{cityFuneral.year}年殡葬服务与公墓设施：
        经营性公墓 <strong>{cityFuneral.commercialCemeteries}</strong>座
        ，公益性墓地 <strong>{cityFuneral.publicCemeteries}</strong>座
        ，殡仪馆 <strong>{cityFuneral.funeralHomes}</strong>座
        ，骨灰堂 <strong>{cityFuneral.columbariums}</strong>座
        ，年火化 <strong>{cityFuneral.annualCremations}</strong>万具
        ，节地生态安葬率 <strong>{cityFuneral.ecoBurialRate}%</strong>
        {cityFuneral.seaBurials > 0 ? `，海葬累计 <strong>${cityFuneral.seaBurials.toLocaleString()}</strong>具` : ''}
        ，公墓存量面积 <strong>{cityFuneral.remainingArea}</strong>万㎡
        <span class="text-xs text-stone-600">（市级数据，来源：<a href={cityFuneral.sourceUrl} class="underline">{cityFuneral.source}</a>）</span>
      </div>
    )}

    {stats && (
      <div class="mx-auto mt-4 max-w-2xl">
        <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
          {stats.gdp && (
            <div class="card p-3 text-center">
              <div class="text-lg font-bold text-accent">{stats.gdp.toLocaleString()}亿</div>
              <div class="text-[10px] text-ink-soft">GDP ({stats.year})</div>
            </div>
          )}
          {stats.perCapitaGdp && (
            <div class="card p-3 text-center">
              <div class="text-lg font-bold text-accent">{(stats.perCapitaGdp / 10000).toFixed(1)}万</div>
              <div class="text-[10px] text-ink-soft">人均GDP (元)</div>
            </div>
          )}
          {stats.urbanDisposableIncome && (
            <div class="card p-3 text-center">
              <div class="text-lg font-bold text-accent">{stats.urbanDisposableIncome.toLocaleString()}</div>
              <div class="text-[10px] text-ink-soft">城镇人均收入 (元)</div>
            </div>
          )}
          {stats.ruralDisposableIncome && (
            <div class="card p-3 text-center">
              <div class="text-lg font-bold text-accent">{stats.ruralDisposableIncome.toLocaleString()}</div>
              <div class="text-[10px] text-ink-soft">农村人均收入 (元)</div>
            </div>
          )}
          {stats.perCapitaConsumption && (
            <div class="card p-3 text-center">
              <div class="text-lg font-bold text-accent">{stats.perCapitaConsumption.toLocaleString()}</div>
              <div class="text-[10px] text-ink-soft">人均消费 (元)</div>
            </div>
          )}
        </div>
        <div class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-4">
          {stats.metroLines && (
            <div class="card p-3 text-center">
              <div class="text-lg font-bold text-accent">{stats.metroLines}条/{stats.metroKm}km</div>
              <div class="text-[10px] text-ink-soft">轨道交通 ({stats.metroStations}站)</div>
            </div>
          )}
          {stats.universities && (
            <div class="card p-3 text-center">
              <div class="text-lg font-bold text-accent">{stats.universities}</div>
              <div class="text-[10px] text-ink-soft">普通高校 (所)</div>
            </div>
          )}
          {stats.healthInstitutions && (
            <div class="card p-3 text-center">
              <div class="text-lg font-bold text-accent">{stats.healthInstitutions.toLocaleString()}</div>
              <div class="text-[10px] text-ink-soft">卫生机构 (个)</div>
            </div>
          )}
          {stats.hospitals && (
            <div class="card p-3 text-center">
              <div class="text-lg font-bold text-accent">{stats.hospitals}</div>
              <div class="text-[10px] text-ink-soft">医院 (个)</div>
            </div>
          )}
        </div>
        {stats.newHousePriceIndex && (
          <p class="mt-2 text-center text-xs text-ink-soft">
            📈 {stats.year}年房价指数：新建住宅 <strong>{stats.newHousePriceIndex}</strong>，二手住宅 <strong>{stats.secondHandPriceIndex}</strong>（上年=100）
          </p>
        )}
      </div>
    )}

    <div class="mt-10">
      <Explorer client:load districts={districts} citySlug={city.key} />
    </div>

    {
      top && (
        <p class="mt-6 text-center text-sm text-ink-soft">
          默认均权下，综合宜居度第一：
          <a href={`/${city.key}/district/${top.district.adcode}`} class="font-semibold text-accent hover:underline">
            {top.district.name}
          </a>
          （{top.grade} 级，{top.composite.toFixed(0)} 分）
        </p>
      )
    }
  </section>

  <section class="container-page pb-16">
    <h2 class="text-xl font-bold">六大评分维度</h2>
    <p class="mt-1 text-sm text-ink-soft">
      每个维度独立打分，可点开看原始数据与来源 —— 详见
      <a href="/methodology" class="text-accent hover:underline">评分方法</a>。
    </p>
    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        METRICS.map((m) => (
          <a
            href={`/${city.key}/rankings/${m.key}`}
            class="card group block p-5 transition hover:-translate-y-0.5 hover:shadow-lg"
          >
            <div class="flex items-center justify-between">
              <h3 class="font-semibold">
                {m.label}
                {!m.real && <span class="ml-1 text-[10px] text-ink-soft">示例</span>}
              </h3>
              <span class="text-xs text-ink-soft transition group-hover:text-accent">排行 →</span>
            </div>
            <p class="mt-2 text-sm text-ink-soft">{m.description}</p>
            <p class="mt-2 text-xs text-ink-soft">单位：{m.unit} · 来源：{m.source}</p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
