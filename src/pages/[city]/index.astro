---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Explorer from '../../components/Explorer.tsx';
import { computeCity, rankWithWeights } from '../../lib/scoring';
import { getDistricts, METRICS } from '../../data/districts';
import { CITIES, getCity } from '../../data/cities';
import { getEnvironment, getEmployment, getGreenery } from '../../data/environment';
import { getCityStats } from '../../data/cityStats';
import { getCulture } from '../../data/culture';
import { getCitySafety } from '../../data/safety';
import { CITY_SPORTS_TOTALS } from '../../data/sports';
import { CITY_ELDERLY_TOTALS } from '../../data/elderly-care';
import { getCityInnovation } from '../../data/innovation';
import { getCityTourism } from '../../data/tourism';
import { getCityClimate } from '../../data/climate';
import { getCityDigital } from '../../data/digitalInfra';
import { getCityCultureTotal } from '../../data/culturalIndustry';
import { getCityLivingCost } from '../../data/livingCost';
import { getCityAirQualityTrend } from '../../data/airQualityTrend';
import { getCityEduRatio } from '../../data/educationQuality';
import { CITY_EMPLOYMENT_TOTALS } from '../../data/employment';
import { CITY_CHILDCARE_TOTALS } from '../../data/childcare';
import { CITY_ENERGY_TOTALS } from '../../data/energy';
import { CITY_POSTAL_TOTALS } from '../../data/postal';
import { CITY_COMMUNITY_TOTALS } from '../../data/communityService';
import { CITY_UTILITY_TOTALS } from '../../data/utilities';
import { getCityHousingQuality } from '../../data/housingQuality';
import { getCityFinancial } from '../../data/financialAccess';
import { getCityDining } from '../../data/diningVitality';
import { CITY_EMERGENCY_TOTALS } from '../../data/emergencyShelter';
import { CITY_TRANSIT_TOTALS } from '../../data/publicTransport';
import { CITY_WATER_TOTALS } from '../../data/waterQuality';
import { CITY_WASTE_TOTALS } from '../../data/wasteManagement';
import { CITY_FAMILY_TOTALS } from '../../data/familyPlanning';
import { CITY_FOOD_TOTALS } from '../../data/foodSafety';
import { SITE } from '../../consts';

export function getStaticPaths() {
  return CITIES.map((c) => ({ params: { city: c.key } }));
}

const city = getCity(Astro.params.city!)!;
const districts = computeCity(getDistricts(city.key));
const ranked = rankWithWeights(districts);
const top = ranked[0];
const env = getEnvironment(city.key);
const emp = getEmployment(city.key);
const green = getGreenery(city.key);
const stats = getCityStats(city.key);
const culture = getCulture(city.key);
const safety = getCitySafety(city.key);
const sportsTotal = CITY_SPORTS_TOTALS[city.key];
const elderlyTotal = CITY_ELDERLY_TOTALS[city.key];
const innovation = getCityInnovation(city.key);
const tourism = getCityTourism(city.key);
const climate = getCityClimate(city.key);
const cityDigital = getCityDigital(city.key);
const cityCultureTotal = getCityCultureTotal(city.key);
const livingCost = getCityLivingCost(city.key);
const aqTrend = getCityAirQualityTrend(city.key);
const cityEduRatio = getCityEduRatio(city.key);
const cityEmployment = CITY_EMPLOYMENT_TOTALS[city.key];
const cityChildcare = CITY_CHILDCARE_TOTALS[city.key];
const cityEnergy = CITY_ENERGY_TOTALS[city.key];
const cityPostal = CITY_POSTAL_TOTALS[city.key];
const cityCommunity = CITY_COMMUNITY_TOTALS[city.key];
const cityUtility = CITY_UTILITY_TOTALS[city.key];
const cityHousingQ = getCityHousingQuality(city.key);
const cityFinancial = getCityFinancial(city.key);
const cityDining = getCityDining(city.key);
const cityEmergency = CITY_EMERGENCY_TOTALS[city.key];
const cityTransitTotal = CITY_TRANSIT_TOTALS[city.key];
const cityWater = CITY_WATER_TOTALS[city.key];
const cityWaste = CITY_WASTE_TOTALS[city.key];
const cityFamily = CITY_FAMILY_TOTALS[city.key];
const cityFood = CITY_FOOD_TOTALS[city.key];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: `${city.name}区县宜居度`,
  url: new URL(`/${city.key}/`, Astro.site).href,
  description: SITE.description,
  inLanguage: SITE.locale,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: ranked.length,
    itemListElement: ranked.slice(0, 5).map((r, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${r.district.name}（${r.grade} 级）`,
      url: new URL(`/${city.key}/district/${r.district.adcode}`, Astro.site).href,
    })),
  },
};
---

<BaseLayout
  title={`${city.name}区县宜居度对比`}
  description={`${city.name}${districts.length} 个区县六维宜居度对比：经济、人口、教育、医疗、交通、生活。人口与配套为真实公开数据，可自定义权重实时重排。`}
  path={`/${city.key}/`}
  keywords={[
    `${city.name}宜居度`,
    `${city.name}区县对比`,
    `${city.name}区县排行榜`,
    `${city.name}哪个区最适合居住`,
    `${city.name}城市规划`,
    `${city.name}区县数据分析`,
    '宜居度对比',
    '区县排行榜',
  ]}
  jsonLd={jsonLd}
>
  <section class="container-page py-10 sm:py-14">
    <div class="mx-auto max-w-3xl text-center">
      <span class="rounded-full bg-accent-soft px-3 py-1 text-xs font-medium text-accent">
        🏙️ {city.name} · {districts.length} 区县 · 六维评分
      </span>
      <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-5xl">
        {city.name} {districts.length} 区，<span class="text-accent">哪个最适合你</span>？
      </h1>
      <p class="mt-4 text-base text-ink-soft sm:text-lg">
        经济、人口、教育、医疗、交通、生活 六维横向对比。拖动权重，地图与排行榜实时重排。
      </p>
    </div>

    <div class="mx-auto mt-8 grid max-w-2xl grid-cols-3 gap-3 text-center">
      <div class="card p-4">
        <div class="text-2xl font-bold text-accent">{districts.length}</div>
        <div class="text-xs text-ink-soft">区县全覆盖</div>
      </div>
      <div class="card p-4">
        <div class="text-2xl font-bold text-accent">{METRICS.length}</div>
        <div class="text-xs text-ink-soft">评分维度</div>
      </div>
      <div class="card p-4">
        <div class="text-2xl font-bold text-accent">自定义</div>
        <div class="text-xs text-ink-soft">权重实时重排</div>
      </div>
    </div>

    {env && (
      <div class="mx-auto mt-4 max-w-2xl rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
        🌿 {city.name}{env.year}年环境：PM2.5 年均 <strong>{env.pm25} μg/m³</strong>，AQI 优良率 <strong>{env.aqiGoodRate}%</strong>
        {env.pm10 && <>，PM10 {env.pm10} μg/m³</>}
        <span class="text-xs text-emerald-600">（市级数据，来源：<a href={env.sourceUrl} class="underline">{env.source}</a>）</span>
      </div>
    )}

    {emp && (
      <div class="mx-auto mt-2 max-w-2xl rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800">
        💼 {city.name}{emp.year}年就业：城镇新增 <strong>{emp.newJobs} 万人</strong>
        {emp.surveyUnemploymentRate && <>，调查失业率 <strong>{emp.surveyUnemploymentRate}%</strong></>}
        <span class="text-xs text-blue-600">（市级数据，来源：<a href={emp.sourceUrl} class="underline">{emp.source}</a>）</span>
      </div>
    )}

    {green && (
      <div class="mx-auto mt-2 max-w-2xl rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">
        🌳 {city.name}{green.year}年绿化：
        {green.perCapitaParkArea && <>人均公园绿地 <strong>{green.perCapitaParkArea} ㎡</strong></>}
        {green.parkCount && <>，公园 <strong>{green.parkCount} 座</strong></>}
        {green.perCapitaSportsArea && <>，人均体育场地 {green.perCapitaSportsArea} ㎡</>}
        <span class="text-xs text-green-600">（市级数据，来源：<a href={green.sourceUrl} class="underline">{green.source}</a>）</span>
      </div>
    )}

    {culture && (
      <div class="mx-auto mt-2 max-w-2xl rounded-lg border border-purple-200 bg-purple-50 px-4 py-3 text-sm text-purple-800">
        🎭 {city.name}{culture.year}年文化设施：
        {culture.museums && <>博物馆/纪念馆 <strong>{culture.museums}</strong>家</>}
        {culture.libraries && <>，公共图书馆 <strong>{culture.libraries}</strong>个</>}
        {culture.cultureCenters && <>，文化馆 <strong>{culture.cultureCenters}</strong>个</>}
        {culture.newCultureSpaces && <>，新型文化空间 <strong>{culture.newCultureSpaces}</strong>个</>}
        <span class="text-xs text-purple-600">（市级数据，来源：<a href={culture.sourceUrl} class="underline">{culture.source}</a>）</span>
      </div>
    )}

    {safety && (
      <div class="mx-auto mt-2 max-w-2xl rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
        🛡️ {city.name}{safety.year}年公共安全：
        生产安全事故 <strong>{safety.workSafetyAccidents}</strong>起/死亡<strong>{safety.workSafetyDeaths}</strong>人
        {safety.foodSafetyRate && <>，食品安全合格率 <strong>{safety.foodSafetyRate}%</strong></>}
        {safety.elderlyCareBeds && <>，养老床位 <strong>{safety.elderlyCareBeds.toLocaleString()}</strong>张</>}
        <span class="text-xs text-rose-600">（市级数据，来源：<a href={safety.sourceUrl} class="underline">{safety.source}</a>）</span>
      </div>
    )}

    {sportsTotal && (
      <div class="mx-auto mt-2 max-w-2xl rounded-lg border border-orange-200 bg-orange-50 px-4 py-3 text-sm text-orange-800">
        🏟️ {city.name}{sportsTotal.year}年体育设施：
        体育场地 <strong>{sportsTotal.totalVenues.toLocaleString()}</strong>个
        ，人均 <strong>{sportsTotal.perCapitaArea}㎡</strong>
        {sportsTotal.fitnessProjects && <>，年度新建健身设施 {sportsTotal.fitnessProjects}个</>}
        <span class="text-xs text-orange-600">（市级数据，来源：<a href={sportsTotal.sourceUrl} class="underline">{sportsTotal.source}</a>）</span>
      </div>
    )}

    {elderlyTotal && (
      <div class="mx-auto mt-2 max-w-2xl rounded-lg border border-indigo-200 bg-indigo-50 px-4 py-3 text-sm text-indigo-800">
        👴 {city.name}{elderlyTotal.year}年养老服务：
        养老机构 <strong>{elderlyTotal.institutions}</strong>家，床位 <strong>{elderlyTotal.beds.toLocaleString()}</strong>张
        {elderlyTotal.communityCenters && <>，社区养老中心 {elderlyTotal.communityCenters}个</>}
        {elderlyTotal.nursingBeds && <>，护理型床位 {(elderlyTotal.nursingBeds / 10000).toFixed(1)}万张</>}
        <span class="text-xs text-indigo-600">（市级数据，来源：<a href={elderlyTotal.sourceUrl} class="underline">{elderlyTotal.source}</a>）</span>
      </div>
    )}

    {climate && (
      <div class="mx-auto mt-2 max-w-2xl rounded-lg border border-orange-200 bg-orange-50 px-4 py-3 text-sm text-orange-800">
        🌡️ {city.name}{climate.year}年气候：年平均气温 <strong>{climate.avgTemp}℃</strong>
        {climate.recordTempYear && '（历史新高）'}
        ，年降水量 <strong>{climate.precipitation}mm</strong>
        ，年日照 <strong>{climate.sunshineHours}小时</strong>
        ，{climate.climateType}
        <span class="text-xs text-orange-600">（市级数据，来源：<a href={climate.sourceUrl} class="underline">{climate.source}</a>）</span>
      </div>
    )}

    {innovation && (
      <div class="mx-auto mt-2 max-w-2xl rounded-lg border border-purple-200 bg-purple-50 px-4 py-3 text-sm text-purple-800">
        🔬 {city.name}{innovation.year}年科技创新：
        {innovation.highTechEnterprises && <>高新技术企业 <strong>{(innovation.highTechEnterprises / 10000).toFixed(1)}万</strong>家</>}
        {innovation.patentsGranted && <>，专利授权 <strong>{innovation.patentsGranted}万</strong>件</>}
        {innovation.highValuePatentsPer10k && <>，每万人高价值发明专利 <strong>{innovation.highValuePatentsPer10k}件</strong></>}
        {innovation.rdExpenditure && <>，R&D经费 <strong>{innovation.rdExpenditure}亿</strong>元（强度{innovation.rdIntensity}%）</>}
        {innovation.digitalEconomyEntities && <>，数字经济核心产业 <strong>{innovation.digitalEconomyEntities}</strong>家</>}
        <span class="text-xs text-purple-600">（市级数据，来源：<a href={innovation.sourceUrl} class="underline">{innovation.source}</a>）</span>
      </div>
    )}

    {tourism && (
      <div class="mx-auto mt-2 max-w-2xl rounded-lg border border-cyan-200 bg-cyan-50 px-4 py-3 text-sm text-cyan-800">
        ✈️ {city.name}{tourism.year}年旅游：
        {tourism.inboundTourists && <>入境游客 <strong>{tourism.inboundTourists}万</strong>人次</>}
        {tourism.domesticTourists && <>，国内游客 <strong>{tourism.domesticTourists.toLocaleString()}万</strong>人次</>}
        {tourism.internationalRevenue && <>，国际旅游收入 <strong>{tourism.internationalRevenue}亿</strong>美元</>}
        {tourism.domesticRevenue && <>，国内旅游收入 <strong>{tourism.domesticRevenue.toLocaleString()}亿</strong>元</>}
        {tourism.railwayPassengers && <>，铁路客运 <strong>{tourism.railwayPassengers}万</strong>人</>}
        {tourism.civilAviationPassengers && <>，民航客运 <strong>{tourism.civilAviationPassengers}万</strong>人</>}
        {tourism.aLevelAttractions && <>，A级景区 <strong>{tourism.aLevelAttractions}</strong>个</>}
        <span class="text-xs text-cyan-600">（市级数据，来源：<a href={tourism.sourceUrl} class="underline">{tourism.source}</a>）</span>
      </div>
    )}

    {cityDigital && (
      <div class="mx-auto mt-2 max-w-2xl rounded-lg border border-purple-200 bg-purple-50 px-4 py-3 text-sm text-purple-800">
        📶 {city.name}{cityDigital.year}年数字化基建：
        {cityDigital.total5GStations && <>5G基站 <strong>{(cityDigital.total5GStations / 10000).toFixed(1)}万</strong>个</>}
        {cityDigital.broadbandHighSpeedRatio && <>，500Mbps+占比 <strong>{cityDigital.broadbandHighSpeedRatio}%</strong></>}
        {cityDigital.digitalGdpRatio && <>，数字经济占GDP <strong>{cityDigital.digitalGdpRatio}%</strong></>}
        {cityDigital.infoServiceRevenue && <>，信息服务业营收 <strong>{cityDigital.infoServiceRevenue.toLocaleString()}亿</strong>元</>}
        <span class="text-xs text-purple-600">（市级数据，来源：<a href={cityDigital.sourceUrl} class="underline">{cityDigital.source}</a>）</span>
      </div>
    )}

    {cityCultureTotal && (
      <div class="mx-auto mt-2 max-w-2xl rounded-lg border border-purple-200 bg-purple-50 px-4 py-3 text-sm text-purple-800">
        🎭 {city.name}{cityCultureTotal.year}年文化产业：
        博物馆/纪念馆 <strong>{cityCultureTotal.totalMuseums}</strong>家
        ，公共图书馆 <strong>{cityCultureTotal.totalLibraries}</strong>个
        ，文化馆 <strong>{cityCultureTotal.totalCulturalCenters}</strong>个
        {cityCultureTotal.performingGroups && <>，艺术表演团体 <strong>{cityCultureTotal.performingGroups}</strong>个</>}
        <span class="text-xs text-purple-600">（市级数据，来源：<a href={cityCultureTotal.sourceUrl} class="underline">{cityCultureTotal.source}</a>）</span>
      </div>
    )}

    {livingCost && (
      <div class="mx-auto mt-2 max-w-2xl rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
        💰 {city.name}{livingCost.year}年生活成本：
        城镇人均收入 <strong>{livingCost.urbanDisposableIncome.toLocaleString()}元</strong>
        ，人均消费 <strong>{livingCost.perCapitaConsumption.toLocaleString()}元</strong>
        ，房价收入比 <strong>{livingCost.housePriceIncomeRatio}年</strong>
        ，生活成本指数 <strong>{livingCost.livingCostIndex}</strong>（上海=100）
        <span class="text-xs text-amber-600">（来源：<a href={livingCost.sourceUrl} class="underline">{livingCost.source}</a>）</span>
      </div>
    )}

    {aqTrend && (
      <div class="mx-auto mt-2 max-w-2xl rounded-lg border border-teal-200 bg-teal-50 px-4 py-3 text-sm text-teal-800">
        🌬️ {city.name}空气质量趋势（2024-2025）：
        PM2.5 从 <strong>{city.key === 'shanghai' ? '28.4' : '33'}μg/m³</strong> 降至 <strong>{aqTrend.annualPM25}μg/m³</strong>
        ，AQI优良率 <strong>{aqTrend.annualAQIGoodRate}%</strong>
        ，趋势 <strong>{aqTrend.trendDirection === 'improving' ? '↗ 持续改善' : '→ 稳定'}</strong>
        <span class="text-xs text-teal-600">（来源：<a href={aqTrend.sourceUrl} class="underline">{aqTrend.source}</a>）</span>
      </div>
    )}

    {cityEduRatio && (
      <div class="mx-auto mt-2 max-w-2xl rounded-lg border border-indigo-200 bg-indigo-50 px-4 py-3 text-sm text-indigo-800">
        📚 {city.name}{cityEduRatio.year}年教育质量：
        中小学 <strong>{cityEduRatio.totalSchools}</strong>所 / 在校 <strong>{(cityEduRatio.totalStudents / 10000).toFixed(1)}万</strong>人
        ，小学师生比 <strong>{cityEduRatio.primaryRatio}</strong> · 初中 <strong>{cityEduRatio.middleRatio}</strong> · 高中 <strong>{cityEduRatio.highRatio}</strong>
        <span class="text-xs text-indigo-600">（来源：<a href={cityEduRatio.sourceUrl} class="underline">{cityEduRatio.source}</a>）</span>
      </div>
    )}

    {cityEmployment && (
      <div class="mx-auto mt-2 max-w-2xl rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800">
        💼 {city.name}{cityEmployment.year}年就业：
        城镇新增就业 <strong>{cityEmployment.newJobs}万</strong>人
        {cityEmployment.surveyUnemploymentRate && <>，调查失业率 <strong>{cityEmployment.surveyUnemploymentRate}%</strong></>}
        {cityEmployment.vocationalTraining && <>，职业培训 <strong>{cityEmployment.vocationalTraining}万</strong>人次</>}
        {cityEmployment.communityServiceStations && <>，社区就业站点 <strong>{cityEmployment.communityServiceStations}</strong>个</>}
        {cityEmployment.ruralLaborTransfer && <>，农村劳动力转移 <strong>{cityEmployment.ruralLaborTransfer}万</strong>人</>}
        <span class="text-xs text-blue-600">（市级数据，来源：<a href={cityEmployment.sourceUrl} class="underline">{cityEmployment.source}</a>）</span>
      </div>
    )}

    {cityChildcare && (
      <div class="mx-auto mt-2 max-w-2xl rounded-lg border border-pink-200 bg-pink-50 px-4 py-3 text-sm text-pink-800">
        🧒 {city.name}{cityChildcare.year}年托育与学前教育：
        幼儿园 <strong>{cityChildcare.kindergartens}</strong>所，在园幼儿 <strong>{cityChildcare.kindergartenStudents}万</strong>人
        {cityChildcare.nurserySubsidyRecipients && <>，育儿补贴覆盖 <strong>{cityChildcare.nurserySubsidyRecipients}万</strong>婴幼儿</>}
        {cityChildcare.preschoolEnrollmentRate && <>，学前三年毛入园率 <strong>{cityChildcare.preschoolEnrollmentRate}%</strong></>}
        <span class="text-xs text-pink-600">（市级数据，来源：<a href={cityChildcare.sourceUrl} class="underline">{cityChildcare.source}</a>）</span>
      </div>
    )}

    {cityEnergy && (
      <div class="mx-auto mt-2 max-w-2xl rounded-lg border border-teal-200 bg-teal-50 px-4 py-3 text-sm text-teal-800">
        ⚡ {city.name}{cityEnergy.year}年能源与环保：
        {cityEnergy.totalPowerConsumption > 0 && <>用电量 <strong>{cityEnergy.totalPowerConsumption}亿</strong>千瓦时（+{cityEnergy.powerGrowthRate}%）</>}
        {cityEnergy.envInvestment && <>，环保投入 <strong>{cityEnergy.envInvestment}亿</strong>元（GDP的{cityEnergy.envInvestmentRatio}%）</>}
        {cityEnergy.dailyWaste && <>，日均垃圾 <strong>{cityEnergy.dailyWaste}万</strong>吨</>}
        {cityEnergy.renewableEnergy && <>，可再生能源发电 <strong>{cityEnergy.renewableEnergy}亿</strong>千瓦时（占{cityEnergy.renewableRatio}%）</>}
        {cityEnergy.totalParks && <>，公园 <strong>{cityEnergy.totalParks}</strong>座</>}
        <span class="text-xs text-teal-600">（市级数据，来源：<a href={cityEnergy.sourceUrl} class="underline">{cityEnergy.source}</a>）</span>
      </div>
    )}

    {cityPostal && (
      <div class="mx-auto mt-2 max-w-2xl rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
        📦 {city.name}{cityPostal.year}年邮政快递：
        邮政业务总量 <strong>{cityPostal.postalRevenue}亿</strong>元
        ，快递业务量 <strong>{cityPostal.expressVolume}亿</strong>件
        {cityPostal.expressOutlets && ` · 网点约${cityPostal.expressOutlets}个`}
        <span class="text-xs text-amber-600">（市级数据，来源：<a href={cityPostal.sourceUrl} class="underline">{cityPostal.source}</a>）</span>
      </div>
    )}

    {cityCommunity && (
      <div class="mx-auto mt-2 max-w-2xl rounded-lg border border-teal-200 bg-teal-50 px-4 py-3 text-sm text-teal-800">
        🏘️ {city.name}{cityCommunity.year}年社区服务：
        街镇 <strong>{cityCommunity.subDistricts + cityCommunity.towns + (cityCommunity.townships || 0)}</strong>个
        ，居委会 <strong>{cityCommunity.residentCommittees}</strong>个
        ，社区服务中心 <strong>{cityCommunity.communityServiceCenters}</strong>个
        ，社区食堂 <strong>{cityCommunity.communityCanteens}</strong>个
        {cityCommunity.hotlineCalls && ` · ${cityCommunity.hotline}热线年接通${cityCommunity.hotlineCalls}万件`}
        <span class="text-xs text-teal-600">（市级数据，来源：<a href={cityCommunity.sourceUrl} class="underline">{cityCommunity.source}</a>）</span>
      </div>
    )}

    {cityUtility && (
      <div class="mx-auto mt-2 max-w-2xl rounded-lg border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-800">
        🚰 {city.name}{cityUtility.year}年公用事业：
        年供水 <strong>{cityUtility.totalWaterSupply}亿</strong>m³
        （管网{cityUtility.pipelineLength.toLocaleString()}km）
        ，燃气{cityUtility.totalGasUsers}万户
        ，污水处理率 <strong>{cityUtility.sewageTreatmentRate}%</strong>
        {cityUtility.heatingArea && ` · 供热${cityUtility.heatingArea.toLocaleString()}万㎡`}
        <span class="text-xs text-sky-600">（市级数据，来源：<a href={cityUtility.sourceUrl} class="underline">{cityUtility.source}</a>）</span>
      </div>
    )}

    {cityHousingQ && (
      <div class="mx-auto mt-2 max-w-2xl rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
        🏠 {city.name}住房与居住品质：
        {cityHousingQ.oldRenovationArea > 0 && `老旧小区改造 <strong>${cityHousingQ.oldRenovationArea}万㎡</strong>`}
        {cityHousingQ.elevatorsAdded > 0 && ` · 加装电梯${cityHousingQ.elevatorsAdded}台`}
        {cityHousingQ.affordableHousing > 0 && ` · 保障房${cityHousingQ.affordableHousing.toLocaleString()}套`}
        {cityHousingQ.residentialSoldArea > 0 && ` · 住宅销售${cityHousingQ.residentialSoldArea}万㎡`}
        {cityHousingQ.newPriceIndex && ` · 新房价格指数${cityHousingQ.newPriceIndex}`}
        <span class="text-xs text-rose-600">（市级数据，来源：{city.key === 'shanghai' ? '上海市2025年统计公报' : '银川市2025年统计公报'}）</span>
      </div>
    )}

    {cityFinancial && (
      <div class="mx-auto mt-2 max-w-2xl rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
        💰 {city.name}金融概况：
        金融业增加值 <strong>{cityFinancial.financialValueAdded}亿</strong>元
        ，存款余额 <strong>{(cityFinancial.totalDeposits / 10000).toFixed(2)}万亿</strong>元
        ，贷款余额 <strong>{(cityFinancial.totalLoans / 10000).toFixed(2)}万亿</strong>元
        ，保费收入 <strong>{cityFinancial.insurancePremium}亿</strong>元
        ，银行网点约{cityFinancial.bankOutlets}个
        <span class="text-xs text-amber-600">（市级数据，来源：{city.key === 'shanghai' ? '上海市2025年统计公报' : '银川市2025年统计公报'}）</span>
      </div>
    )}

    {cityDining && (
      <div class="mx-auto mt-2 max-w-2xl rounded-lg border border-orange-200 bg-orange-50 px-4 py-3 text-sm text-orange-800">
        🍽️ {city.name}消费活力：
        社零总额 <strong>{cityDining.totalRetailSales}亿</strong>元（+{cityDining.retailGrowth}%）
        {cityDining.ecommerceValue && ` · 电商交易额${cityDining.ecommerceValue}万亿`}
        {cityDining.onlineShoppingValue && ` · 网购${cityDining.onlineShoppingValue}万亿`}
        {cityDining.exhibitionsCount && ` · 展览${cityDining.exhibitionsCount}场`}
        {cityDining.accommodationCateringValue && ` · 住宿餐饮${cityDining.accommodationCateringValue}亿`}
        <span class="text-xs text-orange-600">（市级数据，来源：{city.key === 'shanghai' ? '上海市2025年统计公报' : '银川市2025年统计公报'}）</span>
      </div>
    )}

    {cityEmergency && (
      <div class="mx-auto mt-2 max-w-2xl rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
        🚨 {city.name}{cityEmergency.year}年应急与消防：
        应急避难场所 <strong>{cityEmergency.totalShelters}</strong>个
        ，消防站 <strong>{cityEmergency.totalFireStations}</strong>个
        ，消防员 <strong>{cityEmergency.totalFirefighters.toLocaleString()}</strong>人
        ，年度火灾 <strong>{cityEmergency.annualFireIncidents.toLocaleString()}</strong>起
        <span class="text-xs text-red-600">（市级数据，来源：<a href={cityEmergency.sourceUrl} class="underline">{cityEmergency.source}</a>）</span>
      </div>
    )}

    {cityTransitTotal && (
      <div class="mx-auto mt-2 max-w-2xl rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800">
        🚌 {city.name}{cityTransitTotal.year}年公共交通：
        公交线路 <strong>{cityTransitTotal.totalRoutes}</strong>条
        ，公交站点 <strong>{cityTransitTotal.totalStops.toLocaleString()}</strong>个
        ，公交车 <strong>{cityTransitTotal.totalBuses.toLocaleString()}</strong>辆（新能源{cityTransitTotal.newEnergyRatio}%）
        ，出租车 <strong>{cityTransitTotal.totalTaxis.toLocaleString()}</strong>辆
        ，年客运 <strong>{cityTransitTotal.annualRidership}</strong>亿人次
        <span class="text-xs text-blue-600">（市级数据，来源：<a href={cityTransitTotal.sourceUrl} class="underline">{cityTransitTotal.source}</a>）</span>
      </div>
    )}

    {cityWater && (
      <div class="mx-auto mt-2 max-w-2xl rounded-lg border border-cyan-200 bg-cyan-50 px-4 py-3 text-sm text-cyan-800">
        💧 {city.name}{cityWater.year}年水环境：
        {cityWater.mainRiverName}水质 <strong>{cityWater.mainRiverQuality}</strong>
        ，地表水III类+占比 <strong>{cityWater.surfaceWaterQualityRate}%</strong>
        ，污水处理率 <strong>{cityWater.sewageTreatmentRate}%</strong>
        ，再生水利用 <strong>{cityWater.recycledWaterRate}%</strong>
        ，人均日用水 <strong>{cityWater.perCapitaDailyWater}</strong>升
        <span class="text-xs text-cyan-600">（市级数据，来源：<a href={cityWater.sourceUrl} class="underline">{cityWater.source}</a>）</span>
      </div>
    )}

    {cityWaste && (
      <div class="mx-auto mt-2 max-w-4xl rounded-lg bg-emerald-50 px-4 py-2 text-sm text-emerald-900">
        ♻️ {city.name}{cityWaste.year}年垃圾分类与废物管理：
        {cityWaste.wasteIndex > 0 && <>无废指数 <strong>{cityWaste.wasteIndex}</strong>（同比+{cityWaste.wasteIndexTrend}）</>}
        {cityWaste.wasteIndex > 0 && '，'}
        生活垃圾回收利用率 <strong>{cityWaste.recyclingRate}%</strong>
        ，分类实效评估 <strong>{cityWaste.classificationScore}</strong>分
        {cityWaste.dailyWaste > 0 && <>，日均垃圾 <strong>{cityWaste.dailyWaste}</strong>万吨</>}
        {cityWaste.incinerationPlants > 0 && <>，焚烧厂 <strong>{cityWaste.incinerationPlants}</strong>座</>}
        {cityWaste.harmlessRate && <>，无害化率 <strong>{cityWaste.harmlessRate}%</strong></>}
        {cityWaste.resourceRate && <>，资源化率 <strong>{cityWaste.resourceRate}%</strong></>}
        <span class="text-xs text-emerald-600">（市级数据，来源：<a href={cityWaste.sourceUrl} class="underline">{cityWaste.source}</a>）</span>
      </div>
    )}

    {cityFamily && (
      <div class="mx-auto mt-2 max-w-4xl rounded-lg bg-rose-50 px-4 py-2 text-sm text-rose-900">
        👶 {city.name}{cityFamily.year}年婚育与人口：
        总和生育率 <strong>{cityFamily.totalFertilityRate}</strong>
        ，出生率 <strong>{cityFamily.birthRate}‰</strong>
        ，自然增长率 <strong>{cityFamily.naturalGrowthRate > 0 ? '+' : ''}{cityFamily.naturalGrowthRate}‰</strong>
        ，出生 <strong>{cityFamily.births}</strong>万 / 死亡 <strong>{cityFamily.deaths}</strong>万
        ，平均初育年龄 <strong>{cityFamily.avgFirstBirthAge}</strong>岁
        ，常住人口 <strong>{cityFamily.population}</strong>万（性别比{cityFamily.sexRatio}）
        <span class="text-xs text-rose-600">（市级数据，来源：<a href={cityFamily.sourceUrl} class="underline">{cityFamily.source}</a>）</span>
      </div>
    )}

    {cityFood && (
      <div class="mx-auto mt-2 max-w-4xl rounded-lg bg-lime-50 px-4 py-2 text-sm text-lime-900">
        🍽️ {city.name}{cityFood.year}年食品安全：
        食品安全监测合格率 <strong>{cityFood.monitoringPassRate}%</strong>
        ，监督抽检合格率 <strong>{cityFood.inspectionPassRate}%</strong>
        ，年抽检 <strong>{cityFood.annualInspections.toLocaleString()}</strong>批次
        ，{cityFood.fullCoverageCategories}个食品大类合格率100%
        {cityFood.quantGradingSystem && '，实行餐饮量化分级（笑脸/平脸/哭脸）'}
        {cityFood.poisoningIncidents !== undefined && cityFood.poisoningIncidents > 0 ? `，集体食物中毒<strong>${cityFood.poisoningIncidents}</strong>起/<strong>${cityFood.poisoningCases}</strong>人` : '，无集体食物中毒事件'}
        <span class="text-xs text-lime-600">（市级数据，来源：<a href={cityFood.sourceUrl} class="underline">{cityFood.source}</a>）</span>
      </div>
    )}

    {stats && (
      <div class="mx-auto mt-4 max-w-2xl">
        <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
          {stats.gdp && (
            <div class="card p-3 text-center">
              <div class="text-lg font-bold text-accent">{stats.gdp.toLocaleString()}亿</div>
              <div class="text-[10px] text-ink-soft">GDP ({stats.year})</div>
            </div>
          )}
          {stats.perCapitaGdp && (
            <div class="card p-3 text-center">
              <div class="text-lg font-bold text-accent">{(stats.perCapitaGdp / 10000).toFixed(1)}万</div>
              <div class="text-[10px] text-ink-soft">人均GDP (元)</div>
            </div>
          )}
          {stats.urbanDisposableIncome && (
            <div class="card p-3 text-center">
              <div class="text-lg font-bold text-accent">{stats.urbanDisposableIncome.toLocaleString()}</div>
              <div class="text-[10px] text-ink-soft">城镇人均收入 (元)</div>
            </div>
          )}
          {stats.ruralDisposableIncome && (
            <div class="card p-3 text-center">
              <div class="text-lg font-bold text-accent">{stats.ruralDisposableIncome.toLocaleString()}</div>
              <div class="text-[10px] text-ink-soft">农村人均收入 (元)</div>
            </div>
          )}
          {stats.perCapitaConsumption && (
            <div class="card p-3 text-center">
              <div class="text-lg font-bold text-accent">{stats.perCapitaConsumption.toLocaleString()}</div>
              <div class="text-[10px] text-ink-soft">人均消费 (元)</div>
            </div>
          )}
        </div>
        <div class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-4">
          {stats.metroLines && (
            <div class="card p-3 text-center">
              <div class="text-lg font-bold text-accent">{stats.metroLines}条/{stats.metroKm}km</div>
              <div class="text-[10px] text-ink-soft">轨道交通 ({stats.metroStations}站)</div>
            </div>
          )}
          {stats.universities && (
            <div class="card p-3 text-center">
              <div class="text-lg font-bold text-accent">{stats.universities}</div>
              <div class="text-[10px] text-ink-soft">普通高校 (所)</div>
            </div>
          )}
          {stats.healthInstitutions && (
            <div class="card p-3 text-center">
              <div class="text-lg font-bold text-accent">{stats.healthInstitutions.toLocaleString()}</div>
              <div class="text-[10px] text-ink-soft">卫生机构 (个)</div>
            </div>
          )}
          {stats.hospitals && (
            <div class="card p-3 text-center">
              <div class="text-lg font-bold text-accent">{stats.hospitals}</div>
              <div class="text-[10px] text-ink-soft">医院 (个)</div>
            </div>
          )}
        </div>
        {stats.newHousePriceIndex && (
          <p class="mt-2 text-center text-xs text-ink-soft">
            📈 {stats.year}年房价指数：新建住宅 <strong>{stats.newHousePriceIndex}</strong>，二手住宅 <strong>{stats.secondHandPriceIndex}</strong>（上年=100）
          </p>
        )}
      </div>
    )}

    <div class="mt-10">
      <Explorer client:load districts={districts} citySlug={city.key} />
    </div>

    {
      top && (
        <p class="mt-6 text-center text-sm text-ink-soft">
          默认均权下，综合宜居度第一：
          <a href={`/${city.key}/district/${top.district.adcode}`} class="font-semibold text-accent hover:underline">
            {top.district.name}
          </a>
          （{top.grade} 级，{top.composite.toFixed(0)} 分）
        </p>
      )
    }
  </section>

  <section class="container-page pb-16">
    <h2 class="text-xl font-bold">六大评分维度</h2>
    <p class="mt-1 text-sm text-ink-soft">
      每个维度独立打分，可点开看原始数据与来源 —— 详见
      <a href="/methodology" class="text-accent hover:underline">评分方法</a>。
    </p>
    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        METRICS.map((m) => (
          <a
            href={`/${city.key}/rankings/${m.key}`}
            class="card group block p-5 transition hover:-translate-y-0.5 hover:shadow-lg"
          >
            <div class="flex items-center justify-between">
              <h3 class="font-semibold">
                {m.label}
                {!m.real && <span class="ml-1 text-[10px] text-ink-soft">示例</span>}
              </h3>
              <span class="text-xs text-ink-soft transition group-hover:text-accent">排行 →</span>
            </div>
            <p class="mt-2 text-sm text-ink-soft">{m.description}</p>
            <p class="mt-2 text-xs text-ink-soft">单位：{m.unit} · 来源：{m.source}</p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
