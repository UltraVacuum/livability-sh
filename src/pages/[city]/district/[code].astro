---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GradeBadge from '../../../components/GradeBadge.astro';
import RadarChart from '../../../components/RadarChart.tsx';
import { computeCity, rankWithWeights, type ScoredDistrict } from '../../../lib/scoring';
import { getDistricts, METRICS, economySource } from '../../../data/districts';
import { CITIES, getCity } from '../../../data/cities';
import { getEnvironment, getEmployment, getGreenery } from '../../../data/environment';
import { getK12, k12Source, k12Year } from '../../../data/education';
import { getHousingPrice } from '../../../data/housing';
import { getCulture } from '../../../data/culture';
import { getDistrictHealthcare, healthcareSource, healthcareYear } from '../../../data/healthcare';
import { getDistrictCommerce, commerceSource, commerceYear } from '../../../data/commerce';
import { getCitySafety } from '../../../data/safety';
import { getDistrictCommute, commuteSource, commuteYear } from '../../../data/commute';
import { getDistrictSports, sportsSource, sportsYear } from '../../../data/sports';
import { getDistrictElderly, elderlySource, elderlyYear } from '../../../data/elderly-care';
import { getDistrictInnovation, innovationSource, innovationYear, getCityInnovation } from '../../../data/innovation';
import { getCityTourism, tourismSource, tourismYear } from '../../../data/tourism';
import { getCityClimate } from '../../../data/climate';
import { getDistrictHigherEd, higherEdSource, higherEdYear } from '../../../data/higherEducation';
import { getDistrictConsumption, consumptionSource, consumptionYear } from '../../../data/consumption';
import { getDistrictPopFlow, popFlowSource, popFlowYear } from '../../../data/populationFlow';
import { getCityDigital, getDistrictDigital, digitalSource, digitalYear } from '../../../data/digitalInfra';
import { getDistrictCultureVenues, getCityCultureTotal } from '../../../data/culturalIndustry';
import { getCityLivingCost } from '../../../data/livingCost';
import { getCityAirQualityTrend } from '../../../data/airQualityTrend';
import { getDistrictEducationQuality, getCityEduRatio } from '../../../data/educationQuality';
import { getDistrictEmployment, employmentSource, employmentYear, CITY_EMPLOYMENT_TOTALS } from '../../../data/employment';
import { getDistrictChildcare, childcareSource, childcareYear, CITY_CHILDCARE_TOTALS } from '../../../data/childcare';
import { getDistrictEnergy, energySource, energyYear, CITY_ENERGY_TOTALS } from '../../../data/energy';

export function getStaticPaths() {
  const paths = [];
  for (const c of CITIES) {
    for (const d of getDistricts(c.key)) {
      paths.push({ params: { city: c.key, code: d.adcode } });
    }
  }
  return paths;
}

const city = getCity(Astro.params.city!)!;
const code = Astro.params.code!;
const all = computeCity(getDistricts(city.key));
const district = all.find((d) => d.adcode === code);
if (!district) return Astro.redirect('/404');

const ranked = rankWithWeights(all);
const myRank = ranked.findIndex((r) => r.district.adcode === code);
const mine = ranked[myRank];
const prev = ranked[myRank - 1];
const next = ranked[myRank + 1];
const env = getEnvironment(city.key);
const emp = getEmployment(city.key);
const green = getGreenery(city.key);

// K12 教育学段构成（仅部分城市接入；未接入时 k12=undefined，模板不渲染该区块）
const k12 = getK12(city.key, district.adcode);
const k12Total = k12 ? k12.kindergarten + k12.primary + k12.secondary : 0;
const k12Segments = k12
  ? [
      { label: '幼儿园', icon: '🧒', count: k12.kindergarten, color: '#0d9488' },
      { label: '小学', icon: '📚', count: k12.primary, color: '#6366f1' },
      { label: '中学（初中 + 高中）', icon: '🎓', count: k12.secondary, color: '#f59e0b' },
    ]
  : [];

// 房价参考（展示用，非评分维度）
const housing = getHousingPrice(city.key, district.adcode);

// 文化设施（市级参考）
const culture = getCulture(city.key);

// 区级医疗资源（展示用补充数据）
const dh = getDistrictHealthcare(city.key, district.adcode);

// 区级商业/生活便利度（展示用补充数据）
const dc = getDistrictCommerce(city.key, district.adcode);

// 市级公共安全与社会保障（展示用补充数据）
const safety = getCitySafety(city.key);

// 区级通勤交通（展示用补充数据）
const commute = getDistrictCommute(city.key, district.adcode);

// 区级体育设施（展示用补充数据）
const sports = getDistrictSports(city.key, district.adcode);

// 区级养老数据（展示用补充数据）
const elderly = getDistrictElderly(city.key, district.adcode);

// 区级科技创新（展示用补充数据）
const innovation = getDistrictInnovation(city.key, district.adcode);
const cityInnovation = getCityInnovation(city.key);

// 市级旅游数据（展示用补充数据）
const tourism = getCityTourism(city.key);

// 市级气候特征（展示用补充数据）
const climate = getCityClimate(city.key);

// 高等教育数据（区级）
const higherEd = getDistrictHigherEd(city.key, district.adcode);

// 居民消费数据（区级）
const consumption = getDistrictConsumption(city.key, district.adcode);

// 人口密度与流动（区级）
const popFlow = getDistrictPopFlow(city.key, district.adcode);

// 数字化基建（市级+区级）
const cityDigital = getCityDigital(city.key);
const digital = getDistrictDigital(city.key, district.adcode);

// 文化产业（区级场馆+市级总量）
const cultureVenue = getDistrictCultureVenues(city.key, district.adcode);
const cityCultureTotal = getCityCultureTotal(city.key);

// 生活成本对比（市级）
const livingCost = getCityLivingCost(city.key);

// 空气质量趋势（市级）
const aqTrend = getCityAirQualityTrend(city.key);

// 教育质量（区级师生比+名校+市级参考）
const eduQuality = getDistrictEducationQuality(city.key, district.adcode);
const cityEduRatio = getCityEduRatio(city.key);

// 区级就业与劳动力市场
const employment = getDistrictEmployment(city.key, district.adcode);
const cityEmployment = CITY_EMPLOYMENT_TOTALS[city.key];

// 区级托育与学前教育
const childcare = getDistrictChildcare(city.key, district.adcode);
const cityChildcare = CITY_CHILDCARE_TOTALS[city.key];

// 区级能源与环保
const energy = getDistrictEnergy(city.key, district.adcode);
const cityEnergy = CITY_ENERGY_TOTALS[city.key];

const radarSeries = [
  { name: district.name, color: '#0d9488', values: METRICS.map((m) => district.metrics[m.key].score) },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Place',
  name: `${city.name}${district.name}宜居度`,
  description: `${district.name} 的六维宜居度评分（综合 ${mine.composite.toFixed(0)} 分，${mine.grade} 级）。`,
  url: new URL(`/${city.key}/district/${code}`, Astro.site).href,
  containedInPlace: { '@type': 'AdministrativeArea', name: city.name },
};
---

<BaseLayout
  title={`${city.name}${district.name}宜居度评分`}
  description={`${district.name} 六维宜居度：综合 ${mine.composite.toFixed(0)} 分（${mine.grade} 级，${city.name}第 ${mine.rank} 名）。教育、医疗、交通、生活配套密度与人口数据，均为公开数据，来源可追溯。`}
  path={`/${city.key}/district/${code}`}
  keywords={[
    `${city.name}${district.name}宜居度`,
    `${district.name}适合居住吗`,
    `${city.name}${district.name}教育医疗`,
    `${city.name}${district.name}交通生活配套`,
    `${city.name}${district.name}人口密度`,
    `${city.name}哪个区好`,
    `${city.name}区县对比`,
    '宜居度评分',
  ]}
  jsonLd={jsonLd}
>
  <section class="container-page py-10 sm:py-14">
    <a href={`/${city.key}/`} class="text-sm text-ink-soft hover:text-accent">← 返回{city.name}排行榜</a>

    <div class="mt-4 grid gap-6 lg:grid-cols-[auto_1fr]">
      <div class="card flex flex-col items-center justify-center p-6">
        <GradeBadge grade={mine.grade} rank={mine.rank} size="lg" />
        <div class="mt-3 text-center">
          <div class="text-3xl font-bold text-accent">{mine.composite.toFixed(0)}</div>
          <div class="text-xs text-ink-soft">综合宜居度 /100</div>
        </div>
      </div>

      <div class="card p-6">
        <h1 class="text-3xl font-bold tracking-tight">{district.name}</h1>
        <p class="mt-2 text-sm text-ink-soft">{city.name} · 行政区代码 {district.adcode}</p>
        <div class="mt-4">
          <RadarChart client:visible axes={METRICS.map((m) => ({ label: m.shortLabel }))} series={radarSeries} size={220} />
        </div>
      </div>
    </div>

    {env && (
      <div class="mt-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
        🌿 {city.name}{env.year}年环境参考：PM2.5 年均 <strong>{env.pm25} μg/m³</strong>，AQI 优良率 <strong>{env.aqiGoodRate}%</strong>
        <span class="text-xs text-emerald-600">（市级数据，非区级评分维度）</span>
      </div>
    )}

    {(emp || green) && (
      <div class="mt-2 flex flex-wrap gap-2">
        {emp && (
          <div class="rounded-lg border border-blue-200 bg-blue-50 px-3 py-2 text-xs text-blue-800">
            💼 {city.name}{emp.year}年：城镇新增就业 <strong>{emp.newJobs}万人</strong>
            {emp.surveyUnemploymentRate && `，调查失业率 ${emp.surveyUnemploymentRate}%`}
          </div>
        )}
        {green && (
          <div class="rounded-lg border border-green-200 bg-green-50 px-3 py-2 text-xs text-green-800">
            🌳 {city.name}{green.year}年：
            {green.perCapitaParkArea && `人均公园绿地 ${green.perCapitaParkArea}㎡`}
            {green.parkCount && `，公园 ${green.parkCount}座`}
            {green.perCapitaSportsArea && `，人均体育场地 ${green.perCapitaSportsArea}㎡`}
          </div>
        )}
      </div>
    )}

    {housing && (
      <div class="mt-2 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
        🏠 {district.name}居住成本参考：二手房均价约 <strong>{housing.price.toLocaleString()} 元/㎡</strong>
        <span class="text-xs text-amber-600">（{housing.year}年 · {housing.source}，非评分维度）</span>
      </div>
    )}

    {culture && (
      <div class="mt-2 rounded-lg border border-purple-200 bg-purple-50 px-4 py-3 text-sm text-purple-800">
        🎭 {city.name}{culture.year}年文化设施：
        {culture.museums && `博物馆/纪念馆 ${culture.museums}家`}
        {culture.libraries && `，公共图书馆 ${culture.libraries}个`}
        {culture.cultureCenters && `，文化馆 ${culture.cultureCenters}个`}
        {culture.newCultureSpaces && `，新型文化空间 ${culture.newCultureSpaces}个`}
        <span class="text-xs text-purple-600">（市级数据，非区级评分维度）</span>
      </div>
    )}

    <h2 class="mt-10 text-xl font-bold">六维明细</h2>
    <div class="card mt-4 overflow-x-auto p-0">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-line text-xs text-ink-soft">
          <tr>
            <th class="px-4 py-3 font-medium">维度</th>
            <th class="px-4 py-3 font-medium">原始值</th>
            <th class="px-4 py-3 font-medium">评分</th>
            <th class="px-4 py-3 font-medium">排名</th>
            <th class="px-4 py-3 font-medium">数据来源</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          {
            METRICS.map((m) => {
              const ms = (district as ScoredDistrict).metrics[m.key];
              return (
                <tr>
                  <td class="px-4 py-3">
                    <div class="font-medium text-ink">
                      {m.label}
                      {!m.real && <span class="ml-1 text-[10px] text-ink-soft">示例</span>}
                    </div>
                    <div class="text-xs text-ink-soft">{m.description}</div>
                  </td>
                  <td class="px-4 py-3 text-ink-soft">
                    {ms.rawValue.toLocaleString()} <span class="text-xs">{m.unit}</span>
                  </td>
                  <td class="px-4 py-3">
                    <div class="flex items-center gap-2">
                      <span class="w-9 text-sm font-semibold text-ink">{ms.score.toFixed(0)}</span>
                      <span class="h-1.5 w-20 overflow-hidden rounded-full bg-surface-muted">
                        <span class="block h-full rounded-full bg-accent" style={`width:${ms.score}%`} />
                      </span>
                    </div>
                  </td>
                  <td class="px-4 py-3 text-ink-soft">第 {ms.rank} / {all.length}</td>
                  <td class="px-4 py-3 text-xs text-ink-soft">{m.key === 'economy' ? economySource(district.adcode) : m.source}</td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>

    {
      k12 && (
        <div class="mt-6 card p-6">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="text-lg font-bold">🎓 K12 教育学段构成</h3>
            <span class="text-xs text-ink-soft">{k12Year(city.key)} · {k12Source(city.key)}</span>
          </div>
          <p class="mt-1 text-xs text-ink-soft">
            {district.name}共 <strong class="text-ink">{k12Total}</strong> 所 K12 学校（幼儿园 + 小学 + 中学）。展示用补充数据，不参与上方评分。
          </p>
          <div class="mt-4 space-y-3">
            {k12Segments.map((s) => {
              const pct = k12Total ? Math.round((s.count / k12Total) * 100) : 0;
              return (
                <div>
                  <div class="flex items-center justify-between text-sm">
                    <span class="text-ink-soft">
                      {s.icon} {s.label}
                    </span>
                    <span>
                      <strong class="text-ink">{s.count}</strong> 所
                      <span class="ml-1 text-xs text-ink-soft">{pct}%</span>
                    </span>
                  </div>
                  <div class="mt-1 h-2 w-full overflow-hidden rounded-full bg-surface-muted">
                    <span class="block h-full rounded-full" style={`width:${pct}%;background:${s.color}`} />
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )
    }

    {
      dh && (
        <div class="mt-6 card p-6">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="text-lg font-bold">🏥 医疗资源概况</h3>
            <span class="text-xs text-ink-soft">{healthcareYear(city.key)} · {healthcareSource(city.key)}</span>
          </div>
          <p class="mt-1 text-xs text-ink-soft">
            {district.name}医疗资源估算（市级总量按人口比例分配）。展示用补充数据，不参与上方评分。
          </p>
          <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
            <div class="rounded-lg border border-line bg-surface px-4 py-3">
              <div class="text-xs text-ink-soft">卫生机构</div>
              <div class="mt-1 text-xl font-bold text-ink">{dh.institutions}</div>
              <div class="text-[10px] text-ink-soft">所（估算）</div>
            </div>
            <div class="rounded-lg border border-line bg-surface px-4 py-3">
              <div class="text-xs text-ink-soft">医院</div>
              <div class="mt-1 text-xl font-bold text-ink">{dh.hospitals}</div>
              <div class="text-[10px] text-ink-soft">家（估算）</div>
            </div>
            <div class="rounded-lg border border-line bg-surface px-4 py-3">
              <div class="text-xs text-ink-soft">卫生技术人员</div>
              <div class="mt-1 text-xl font-bold text-ink">{dh.healthWorkers.toLocaleString()}</div>
              <div class="text-[10px] text-ink-soft">人（估算）</div>
            </div>
            {dh.beds && (
              <div class="rounded-lg border border-line bg-surface px-4 py-3">
                <div class="text-xs text-ink-soft">编制床位</div>
                <div class="mt-1 text-xl font-bold text-ink">{dh.beds.toLocaleString()}</div>
                <div class="text-[10px] text-ink-soft">张（估算）</div>
              </div>
            )}
          </div>
        </div>
      )
    }

    {
      dc && (
        <div class="mt-6 card p-6">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="text-lg font-bold">🛍️ 商业/生活便利度</h3>
            <span class="text-xs text-ink-soft">{commerceYear(city.key)} · {commerceSource(city.key)}</span>
          </div>
          <p class="mt-1 text-xs text-ink-soft">
            {district.name}商业综合体与市场数量。展示用补充数据，不参与上方评分。
          </p>
          <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
            <div class="rounded-lg border border-line bg-surface px-4 py-3">
              <div class="text-xs text-ink-soft">购物中心/商业综合体</div>
              <div class="mt-1 text-xl font-bold text-ink">{dc.malls}</div>
              <div class="text-[10px] text-ink-soft">个（3万㎡以上）</div>
            </div>
            {dc.markets !== undefined && (
              <div class="rounded-lg border border-line bg-surface px-4 py-3">
                <div class="text-xs text-ink-soft">农贸市场/商品交易市场</div>
                <div class="mt-1 text-xl font-bold text-ink">{dc.markets}</div>
                <div class="text-[10px] text-ink-soft">个</div>
              </div>
            )}
          </div>
        </div>
      )
    }

    {
      commute && (
        <div class="mt-6 card p-6">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="text-lg font-bold">🚇 通勤交通画像</h3>
            <span class="text-xs text-ink-soft">{commuteYear(city.key)} · {commuteSource(city.key)}</span>
          </div>
          <p class="mt-1 text-xs text-ink-soft">
            {district.name}通勤交通数据。展示用补充数据，不参与上方评分。
          </p>
          <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
            <div class="rounded-lg border border-line bg-surface px-4 py-3">
              <div class="text-xs text-ink-soft">平均单程通勤时间</div>
              <div class="mt-1 text-xl font-bold text-ink">{commute.avgCommuteMinutes}</div>
              <div class="text-[10px] text-ink-soft">分钟</div>
            </div>
            {commute.metroDensity !== undefined && (
              <div class="rounded-lg border border-line bg-surface px-4 py-3">
                <div class="text-xs text-ink-soft">地铁站密度</div>
                <div class="mt-1 text-xl font-bold text-ink">{commute.metroDensity.toFixed(2)}</div>
                <div class="text-[10px] text-ink-soft">站/km²</div>
              </div>
            )}
            {commute.metroStations > 0 && (
              <div class="rounded-lg border border-line bg-surface px-4 py-3">
                <div class="text-xs text-ink-soft">地铁站数量</div>
                <div class="mt-1 text-xl font-bold text-ink">{commute.metroStations}</div>
                <div class="text-[10px] text-ink-soft">个（高德POI）</div>
              </div>
            )}
            {commute.busDensity !== undefined && (
              <div class="rounded-lg border border-line bg-surface px-4 py-3">
                <div class="text-xs text-ink-soft">公交线网密度</div>
                <div class="mt-1 text-xl font-bold text-ink">{commute.busDensity}</div>
                <div class="text-[10px] text-ink-soft">公里/万人</div>
              </div>
            )}
          </div>
        </div>
      )
    }

    {
      safety && (
        <div class="mt-6 card p-6">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="text-lg font-bold">🛡️ 公共安全与社会保障</h3>
            <span class="text-xs text-ink-soft">{safety.year}年 · {safety.source}</span>
          </div>
          <p class="mt-1 text-xs text-ink-soft">
            {city.name}{safety.year}年公共安全与社会保障概况。市级数据，非区级评分维度。
          </p>
          <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
            <div class="rounded-lg border border-red-100 bg-red-50 px-4 py-3">
              <div class="text-xs text-red-700">生产安全事故</div>
              <div class="mt-1 text-xl font-bold text-red-900">{safety.workSafetyAccidents}</div>
              <div class="text-[10px] text-red-600">起 / 死亡{safety.workSafetyDeaths}人</div>
            </div>
            {safety.foodSafetyRate !== undefined && (
              <div class="rounded-lg border border-emerald-100 bg-emerald-50 px-4 py-3">
                <div class="text-xs text-emerald-700">食品安全合格率</div>
                <div class="mt-1 text-xl font-bold text-emerald-900">{safety.foodSafetyRate}%</div>
                <div class="text-[10px] text-emerald-600">监测总体合格</div>
              </div>
            )}
            {safety.elderlyCareBeds !== undefined && (
              <div class="rounded-lg border border-line bg-surface px-4 py-3">
                <div class="text-xs text-ink-soft">养老床位</div>
                <div class="mt-1 text-xl font-bold text-ink">{safety.elderlyCareBeds.toLocaleString()}</div>
                <div class="text-[10px] text-ink-soft">张（市级）</div>
              </div>
            )}
            {safety.elderlyCareCenters !== undefined && (
              <div class="rounded-lg border border-line bg-surface px-4 py-3">
                <div class="text-xs text-ink-soft">为老服务中心</div>
                <div class="mt-1 text-xl font-bold text-ink">{safety.elderlyCareCenters}</div>
                <div class="text-[10px] text-ink-soft">个（市级）</div>
              </div>
            )}
            {safety.pensionParticipants !== undefined && (
              <div class="rounded-lg border border-line bg-surface px-4 py-3">
                <div class="text-xs text-ink-soft">养老保险参保</div>
                <div class="mt-1 text-xl font-bold text-ink">{safety.pensionParticipants.toLocaleString()}</div>
                <div class="text-[10px] text-ink-soft">万人（市级）</div>
              </div>
            )}
            {safety.medicalInsuranceParticipants !== undefined && (
