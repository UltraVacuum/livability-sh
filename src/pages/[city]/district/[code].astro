            <div class="text-[10px] text-purple-600">座</div>
          </div>
          <div class="rounded-lg border border-emerald-100 bg-emerald-50 px-4 py-3">
            <div class="text-xs text-emerald-700">有效灌溉面积</div>
            <div class="mt-1 text-xl font-bold text-emerald-900">{waterFacility.irrigationArea}</div>
            <div class="text-[10px] text-emerald-600">万亩</div>
          </div>
          <div class="rounded-lg border border-indigo-100 bg-indigo-50 px-4 py-3">
            <div class="text-xs text-indigo-700">渠道长度</div>
            <div class="mt-1 text-xl font-bold text-indigo-900">{waterFacility.canalLength}</div>
            <div class="text-[10px] text-indigo-600">km</div>
          </div>
        </div>
        {cityWaterFac && (
          <p class="mt-3 text-xs text-ink-soft">
            💧 {city.name}市级参考：水库 <strong>{cityWaterFac.totalReservoirs}</strong> 座，堤防 <strong>{cityWaterFac.totalEmbankment}</strong> km，水闸 <strong>{cityWaterFac.totalSluices.toLocaleString()}</strong> 座，泵站 <strong>{cityWaterFac.totalPumpStations.toLocaleString()}</strong> 座，灌溉 <strong>{cityWaterFac.totalIrrigation}</strong> 万亩，年供水 <strong>{cityWaterFac.waterSupply}</strong> 亿m³
          </p>
        )}
      </div>
    )}

    <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
      <div class="flex gap-2 text-sm">
        {prev && <a href={`/${city.key}/district/${prev.district.adcode}`} class="rounded-lg border border-line px-3 py-2 text-ink-soft transition hover:text-accent">← {prev.district.name}</a>}
        {next && <a href={`/${city.key}/district/${next.district.adcode}`} class="rounded-lg border border-line px-3 py-2 text-ink-soft transition hover:text-accent">{next.district.name} →</a>}
      </div>
      <a href={`/${city.key}/compare`} class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white transition hover:bg-accent-strong">加入对比 →</a>
    </div>
  </section>
</BaseLayout>
