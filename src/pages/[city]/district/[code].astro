              <div class="text-xs text-ink-soft">城镇化率</div>
              <div class="mt-1 text-xl font-bold text-ink">{popFlow.urbanizationRate}%</div>
              <div class="text-[10px] text-ink-soft">城镇人口占比</div>
            </div>
          )}
          {popFlow.flowRatio !== undefined && (
            <div class="rounded-lg border border-purple-100 bg-purple-50 px-4 py-3">
              <div class="text-xs text-purple-700">流动人口占比</div>
              <div class="mt-1 text-xl font-bold text-purple-900">{popFlow.flowRatio}%</div>
              <div class="text-[10px] text-purple-600">外来{popFlow.flowPopulation}万 / 户籍{popFlow.householdPop}万</div>
            </div>
          )}
          {popFlow.growthSinceCensus !== undefined && (
            <div class={`rounded-lg border px-4 py-3 ${
              popFlow.trend === 'growing'
                ? 'border-emerald-100 bg-emerald-50'
                : popFlow.trend === 'declining'
                  ? 'border-red-100 bg-red-50'
                  : 'border-line bg-surface'
            }`}>
              <div class={`text-xs ${
                popFlow.trend === 'growing'
                  ? 'text-emerald-700'
                  : popFlow.trend === 'declining'
                    ? 'text-red-700'
                    : 'text-ink-soft'
              }`}>七普以来变化</div>
              <div class={`mt-1 text-xl font-bold ${
                popFlow.trend === 'growing'
                  ? 'text-emerald-900'
                  : popFlow.trend === 'declining'
                    ? 'text-red-900'
                    : 'text-ink'
              }`}>
                {popFlow.growthSinceCensus > 0 ? '+' : ''}{popFlow.growthSinceCensus}%
              </div>
              <div class={`text-[10px] ${
                popFlow.trend === 'growing'
                  ? 'text-emerald-600'
                  : popFlow.trend === 'declining'
                    ? 'text-red-600'
                    : 'text-ink-soft'
              }`}>
                {popFlow.trend === 'growing' ? '人口净流入' : popFlow.trend === 'declining' ? '人口净流出' : '基本稳定'}
              </div>
            </div>
          )}
        </div>
      </div>
    )}

    {(digital || cityDigital) && (
      <div class="mt-6 card p-6">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h3 class="text-lg font-bold">📶 数字化基建</h3>
          <span class="text-xs text-ink-soft">{digitalYear(city.key)} · {digitalSource(city.key)}</span>
        </div>
        <p class="mt-1 text-xs text-ink-soft">
          {district.name}数字化基础设施概况。展示用补充数据，不参与上方评分。
        </p>
        <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
          {cityDigital?.total5GStations !== undefined && (
            <div class="rounded-lg border border-purple-100 bg-purple-50 px-4 py-3">
              <div class="text-xs text-purple-700">全市5G基站</div>
              <div class="mt-1 text-xl font-bold text-purple-900">{(cityDigital.total5GStations / 10000).toFixed(1)}万</div>
              <div class="text-[10px] text-purple-600">个（市级）</div>
            </div>
          )}
          {cityDigital?.digitalGdpRatio !== undefined && (
            <div class="rounded-lg border border-purple-100 bg-purple-50 px-4 py-3">
              <div class="text-xs text-purple-700">数字经济占GDP</div>
              <div class="mt-1 text-xl font-bold text-purple-900">{cityDigital.digitalGdpRatio}%</div>
              <div class="text-[10px] text-purple-600">核心产业增加值</div>
            </div>
          )}
          {digital?.baseStations5G !== undefined && (
            <div class="rounded-lg border border-line bg-surface px-4 py-3">
              <div class="text-xs text-ink-soft">区级5G基站</div>
              <div class="mt-1 text-xl font-bold text-ink">{digital.baseStations5G.toLocaleString()}</div>
              <div class="text-[10px] text-ink-soft">个（估算）</div>
            </div>
          )}
          {digital?.fiberCoverageRate !== undefined && (
            <div class="rounded-lg border border-line bg-surface px-4 py-3">
              <div class="text-xs text-ink-soft">光纤覆盖率</div>
              <div class="mt-1 text-xl font-bold text-ink">{digital.fiberCoverageRate}%</div>
              <div class="text-[10px] text-ink-soft">千兆宽带</div>
            </div>
          )}
          {digital?.broadbandSpeed !== undefined && (
            <div class="rounded-lg border border-line bg-surface px-4 py-3">
              <div class="text-xs text-ink-soft">平均宽带速率</div>
              <div class="mt-1 text-xl font-bold text-ink">{digital.broadbandSpeed}</div>
              <div class="text-[10px] text-ink-soft">Mbps</div>
            </div>
          )}
          {digital?.digitalCompanies !== undefined && (
            <div class="rounded-lg border border-line bg-surface px-4 py-3">
              <div class="text-xs text-ink-soft">数字经济企业</div>
              <div class="mt-1 text-xl font-bold text-ink">{digital.digitalCompanies.toLocaleString()}</div>
              <div class="text-[10px] text-ink-soft">家（估算）</div>
            </div>
          )}
        </div>
      </div>
    )}

    <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
      <div class="flex gap-2 text-sm">
        {prev && <a href={`/${city.key}/district/${prev.district.adcode}`} class="rounded-lg border border-line px-3 py-2 text-ink-soft transition hover:text-accent">← {prev.district.name}</a>}
        {next && <a href={`/${city.key}/district/${next.district.adcode}`} class="rounded-lg border border-line px-3 py-2 text-ink-soft transition hover:text-accent">{next.district.name} →</a>}
      </div>
      <a href={`/${city.key}/compare`} class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white transition hover:bg-accent-strong">加入对比 →</a>
    </div>
  </section>
</BaseLayout>
