---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GradeBadge from '../../../components/GradeBadge.astro';
import RadarChart from '../../../components/RadarChart.tsx';
import { computeCity, rankWithWeights, type ScoredDistrict } from '../../../lib/scoring';
import { getDistricts, METRICS, economySource } from '../../../data/districts';
import { CITIES, getCity } from '../../../data/cities';
import { getEnvironment, getEmployment, getGreenery } from '../../../data/environment';
import { getK12, k12Source, k12Year } from '../../../data/education';
import { getHousingPrice } from '../../../data/housing';
import { getCulture } from '../../../data/culture';
import { getDistrictHealthcare, healthcareSource, healthcareYear } from '../../../data/healthcare';
import { getDistrictCommerce, commerceSource, commerceYear } from '../../../data/commerce';
import { getCitySafety } from '../../../data/safety';
import { getDistrictCommute, commuteSource, commuteYear } from '../../../data/commute';
import { getDistrictSports, sportsSource, sportsYear } from '../../../data/sports';
import { getDistrictElderly, elderlySource, elderlyYear } from '../../../data/elderly-care';
import { getDistrictInnovation, innovationSource, innovationYear, getCityInnovation } from '../../../data/innovation';
import { getCityTourism, tourismSource, tourismYear } from '../../../data/tourism';
import { getCityClimate } from '../../../data/climate';
import { getDistrictHigherEd, higherEdSource, higherEdYear } from '../../../data/higherEducation';
import { getDistrictConsumption, consumptionSource, consumptionYear } from '../../../data/consumption';
import { getDistrictPopFlow, popFlowSource, popFlowYear } from '../../../data/populationFlow';
import { getCityDigital, getDistrictDigital, digitalSource, digitalYear } from '../../../data/digitalInfra';
import { getDistrictCultureVenues, getCityCultureTotal } from '../../../data/culturalIndustry';
import { getCityLivingCost } from '../../../data/livingCost';
import { getCityAirQualityTrend } from '../../../data/airQualityTrend';
import { getDistrictEducationQuality, getCityEduRatio } from '../../../data/educationQuality';
import { getDistrictEmployment, employmentSource, employmentYear, CITY_EMPLOYMENT_TOTALS } from '../../../data/employment';
import { getDistrictChildcare, childcareSource, childcareYear, CITY_CHILDCARE_TOTALS } from '../../../data/childcare';
import { getDistrictEnergy, energySource, energyYear, CITY_ENERGY_TOTALS } from '../../../data/energy';
import { getDistrictPostal, postalSource, postalYear, CITY_POSTAL_TOTALS } from '../../../data/postal';
import { getDistrictCommunity, communitySource, communityYear, CITY_COMMUNITY_TOTALS } from '../../../data/communityService';
import { getDistrictUtility, utilitySource, utilityYear, CITY_UTILITY_TOTALS } from '../../../data/utilities';
import { getDistrictHousingQuality, getCityHousingQuality, housingQualitySource, housingQualityYear } from '../../../data/housingQuality';
import { getDistrictFinancial, getCityFinancial, financialSource, financialYear, CITY_FINANCIAL_TOTALS } from '../../../data/financialAccess';
import { getDistrictDining, getCityDining, diningSource, diningYear, CITY_DINING_TOTALS } from '../../../data/diningVitality';
import { getDistrictEmergency, emergencySource, emergencyYear, CITY_EMERGENCY_TOTALS } from '../../../data/emergencyShelter';
import { getDistrictTransitDetail, transitSource, transitYear, CITY_TRANSIT_TOTALS } from '../../../data/publicTransport';
import { getDistrictWater, waterSource, waterYear, CITY_WATER_TOTALS } from '../../../data/waterQuality';
import { getDistrictWaste, wasteSource, wasteYear, CITY_WASTE_TOTALS } from '../../../data/wasteManagement';
import { getDistrictFamily, familySource, familyYear, CITY_FAMILY_TOTALS } from '../../../data/familyPlanning';
import { getDistrictFoodSafety, foodSafetySource, foodSafetyYear, CITY_FOOD_TOTALS } from '../../../data/foodSafety';
import { getDistrictOutdoor, outdoorSource, outdoorYear, CITY_OUTDOOR_TOTALS } from '../../../data/outdoorRecreation';
import { getDistrictNight, nightSource, nightYear, CITY_NIGHT_TOTALS } from '../../../data/nighttimeEconomy';
import { getDistrictPet, petSource, petYear, CITY_PET_TOTALS } from '../../../data/petFriendly';
import { getDistrictEntities, entitySource, entityYear, CITY_ENTITY_TOTALS } from '../../../data/marketEntities';
import { getDistrictCommunityHealth, communityHealthSource, communityHealthYear, CITY_COMMUNITY_HEALTH_TOTALS } from '../../../data/communityHealth';
import { getDistrictAssistance, assistanceSource, assistanceYear, CITY_ASSISTANCE_TOTALS } from '../../../data/socialAssistance';
import { getDistrictHousingSecurity, housingSecuritySource, housingSecurityYear, CITY_HOUSING_SECURITY_TOTALS } from '../../../data/housingSecurity';
import { getDistrictRoadSafety, roadSafetySource, roadSafetyYear, CITY_ROAD_SAFETY_TOTALS } from '../../../data/roadSafety';
import { getDistrictSanitation, sanitationSource, sanitationYear, CITY_SANITATION_TOTALS } from '../../../data/sanitation';
import { getDistrictMentalHealth, mentalHealthSource, mentalHealthYear, CITY_MENTAL_TOTALS } from '../../../data/mentalHealth';
import { getDistrictLegalService, legalServiceSource, legalServiceYear, CITY_LEGAL_TOTALS } from '../../../data/legalService';
import { getDistrictVolunteer, volunteerSource, volunteerYear, CITY_VOLUNTEER_TOTALS } from '../../../data/volunteer';
import { getDistrictRenewable, renewableSource, renewableYear, CITY_RENEWABLE_TOTALS } from '../../../data/renewableEnergy';
import { getDistrictDigitalLife, digitalLifeSource, digitalLifeYear, CITY_DIGITAL_LIFE_TOTALS } from '../../../data/digitalLife';
import { getDistrictAgriculture, agricultureSource, agricultureYear, CITY_AGRICULTURE_TOTALS } from '../../../data/agriculture';
import { getDistrictEmploymentService, employmentServiceSource, employmentServiceYear, CITY_EMP_SERVICE_TOTALS } from '../../../data/employmentService';
import { getDistrictDisasterRisk, disasterRiskSource, disasterRiskYear, CITY_DISASTER_TOTALS } from '../../../data/disasterRisk';
import { getDistrictAccessibility, accessibilitySource, accessibilityYear, CITY_ACCESSIBILITY_TOTALS } from '../../../data/accessibility';
import { getDistrictLibrary, librarySource, libraryYear, CITY_LIBRARY_TOTALS } from '../../../data/libraryService';
import { getDistrictFuneral, funeralSource, funeralYear, CITY_FUNERAL_TOTALS } from '../../../data/funeralService';
import { getDistrictGovService, govServiceSource, govServiceYear, CITY_GOV_SERVICE_TOTALS } from '../../../data/govService';
import { getDistrictYouthActivity, youthActivitySource, youthActivityYear, CITY_YOUTH_TOTALS } from '../../../data/youthActivity';
import { getDistrictMassSports, massSportsSource, massSportsYear, CITY_MASS_SPORTS_TOTALS } from '../../../data/massSports';
import { getDistrictMarriage, marriageSource, marriageYear, CITY_MARRIAGE_TOTALS } from '../../../data/marriage';
import { getDistrictChildFriendly, childFriendlySource, childFriendlyYear, CITY_CHILD_TOTALS } from '../../../data/childFriendly';
import { getDistrictUrbanRenewal, urbanRenewalSource, urbanRenewalYear, CITY_RENEWAL_TOTALS } from '../../../data/urbanRenewal';
import { getDistrictCulturalService, culturalServiceSource, culturalServiceYear, CITY_CULTURAL_SVC_TOTALS } from '../../../data/culturalService';
import { getDistrictPharmacy, pharmacySource, pharmacyYear, CITY_PHARMACY_TOTALS } from '../../../data/pharmacy';
import { getDistrictDisability, disabilitySource, disabilityYear, CITY_DISABILITY_TOTALS } from '../../../data/disabilityService';
import { getDistrictFinancialService, financialServiceSource, financialServiceYear, CITY_FIN_SVC_TOTALS } from '../../../data/financialService';
import { getDistrictVeteran, veteranSource, veteranYear, CITY_VETERAN_TOTALS } from '../../../data/veteranService';
import { getDistrictCanteen, canteenSource, canteenYear, CITY_CANTEEN_TOTALS } from '../../../data/communityCanteen';
import { getDistrictWifi, wifiSource, wifiYear, CITY_WIFI_TOTALS } from '../../../data/publicWifi';
import { getDistrictCulturalConsumption, culturalConsumptionSource, culturalConsumptionYear, CITY_CULTURAL_CONS_TOTALS } from '../../../data/culturalConsumption';
import { getDistrictForeignTrade, foreignTradeSource, foreignTradeYear, CITY_TRADE_TOTALS } from '../../../data/foreignTrade';
import { getDistrictWaterFacility, waterFacilitySource, waterFacilityYear, CITY_WATER_FAC_TOTALS } from '../../../data/waterFacility';

export function getStaticPaths() {
  const paths = [];
  for (const c of CITIES) {
    for (const d of getDistricts(c.key)) {
      paths.push({ params: { city: c.key, code: d.adcode } });
    }
  }
  return paths;
}

const city = getCity(Astro.params.city!)!;
const code = Astro.params.code!;
const all = computeCity(getDistricts(city.key));
const district = all.find((d) => d.adcode === code);
if (!district) return Astro.redirect('/404');

const ranked = rankWithWeights(all);
const myRank = ranked.findIndex((r) => r.district.adcode === code);
const mine = ranked[myRank];
const prev = ranked[myRank - 1];
const next = ranked[myRank + 1];
const env = getEnvironment(city.key);
const emp = getEmployment(city.key);
const green = getGreenery(city.key);

// K12 教育学段构成（仅部分城市接入；未接入时 k12=undefined，模板不渲染该区块）
const k12 = getK12(city.key, district.adcode);
const k12Total = k12 ? k12.kindergarten + k12.primary + k12.secondary : 0;
const k12Segments = k12
  ? [
      { label: '幼儿园', icon: '🧒', count: k12.kindergarten, color: '#0d9488' },
      { label: '小学', icon: '📚', count: k12.primary, color: '#6366f1' },
      { label: '中学（初中 + 高中）', icon: '🎓', count: k12.secondary, color: '#f59e0b' },
    ]
  : [];

// 房价参考（展示用，非评分维度）
const housing = getHousingPrice(city.key, district.adcode);

// 文化设施（市级参考）
const culture = getCulture(city.key);

// 区级医疗资源（展示用补充数据）
const dh = getDistrictHealthcare(city.key, district.adcode);

// 区级商业/生活便利度（展示用补充数据）
const dc = getDistrictCommerce(city.key, district.adcode);

// 市级公共安全与社会保障（展示用补充数据）
const safety = getCitySafety(city.key);

// 区级通勤交通（展示用补充数据）
const commute = getDistrictCommute(city.key, district.adcode);

// 区级体育设施（展示用补充数据）
const sports = getDistrictSports(city.key, district.adcode);

// 区级养老数据（展示用补充数据）
const elderly = getDistrictElderly(city.key, district.adcode);

// 区级科技创新（展示用补充数据）
const innovation = getDistrictInnovation(city.key, district.adcode);
const cityInnovation = getCityInnovation(city.key);

// 市级旅游数据（展示用补充数据）
const tourism = getCityTourism(city.key);

// 市级气候特征（展示用补充数据）
const climate = getCityClimate(city.key);

// 高等教育数据（区级）
const higherEd = getDistrictHigherEd(city.key, district.adcode);

// 居民消费数据（区级）
const consumption = getDistrictConsumption(city.key, district.adcode);

// 人口密度与流动（区级）
const popFlow = getDistrictPopFlow(city.key, district.adcode);

// 数字化基建（市级+区级）
const cityDigital = getCityDigital(city.key);
const digital = getDistrictDigital(city.key, district.adcode);

// 文化产业（区级场馆+市级总量）
const cultureVenue = getDistrictCultureVenues(city.key, district.adcode);
const cityCultureTotal = getCityCultureTotal(city.key);

// 生活成本对比（市级）
const livingCost = getCityLivingCost(city.key);

// 空气质量趋势（市级）
const aqTrend = getCityAirQualityTrend(city.key);

// 教育质量（区级师生比+名校+市级参考）
const eduQuality = getDistrictEducationQuality(city.key, district.adcode);
const cityEduRatio = getCityEduRatio(city.key);

// 区级就业与劳动力市场
const employment = getDistrictEmployment(city.key, district.adcode);
const cityEmployment = CITY_EMPLOYMENT_TOTALS[city.key];

// 区级托育与学前教育
const childcare = getDistrictChildcare(city.key, district.adcode);
const cityChildcare = CITY_CHILDCARE_TOTALS[city.key];

// 区级能源与环保
const energy = getDistrictEnergy(city.key, district.adcode);
const cityEnergy = CITY_ENERGY_TOTALS[city.key];

// 邮政快递物流（区级）
const postal = getDistrictPostal(city.key, district.adcode);
const cityPostal = CITY_POSTAL_TOTALS[city.key];

// 社区服务设施（区级）
const community = getDistrictCommunity(city.key, district.adcode);
const cityCommunity = CITY_COMMUNITY_TOTALS[city.key];

// 市政公用事业（区级）
const utility = getDistrictUtility(city.key, district.adcode);
const cityUtility = CITY_UTILITY_TOTALS[city.key];

// 住房与居住品质（区级+市级）
const housingQ = getDistrictHousingQuality(city.key, district.adcode);
const cityHousingQ = getCityHousingQuality(city.key);

// 金融服务可达性（区级+市级）
const financial = getDistrictFinancial(city.key, district.adcode);
const cityFinancial = getCityFinancial(city.key);

// 餐饮与消费活力（区级+市级）
const dining = getDistrictDining(city.key, district.adcode);
const cityDining = getCityDining(city.key);

// 应急避难与消防（区级）
const emergency = getDistrictEmergency(city.key, district.adcode);
const cityEmergency = CITY_EMERGENCY_TOTALS[city.key];

// 公共交通细化（区级）
const transitDetail = getDistrictTransitDetail(city.key, district.adcode);
const cityTransitTotal = CITY_TRANSIT_TOTALS[city.key];

// 水资源与水环境质量（区级）
const water = getDistrictWater(city.key, district.adcode);
const cityWater = CITY_WATER_TOTALS[city.key];

// 垃圾分类与废物管理（区级）
const waste = getDistrictWaste(city.key, district.adcode);
const cityWaste = CITY_WASTE_TOTALS[city.key];

// 婚育与人口（区级）
const family = getDistrictFamily(city.key, district.adcode);
const cityFamily = CITY_FAMILY_TOTALS[city.key];

// 食品安全（区级）
const food = getDistrictFoodSafety(city.key, district.adcode);
const cityFood = CITY_FOOD_TOTALS[city.key];

// 户外休闲（区级）
const outdoor = getDistrictOutdoor(city.key, district.adcode);
const cityOutdoor = CITY_OUTDOOR_TOTALS[city.key];

// 夜间经济（区级）
const night = getDistrictNight(city.key, district.adcode);
const cityNight = CITY_NIGHT_TOTALS[city.key];

// 宠物友好（区级）
const pet = getDistrictPet(city.key, district.adcode);
const cityPet = CITY_PET_TOTALS[city.key];

// 市场主体与营商环境（区级）
const entities = getDistrictEntities(city.key, district.adcode);
const cityEntities = CITY_ENTITY_TOTALS[city.key];

// 社区卫生服务（区级）
const communityHealth = getDistrictCommunityHealth(city.key, district.adcode);
const cityCommunityHealth = CITY_COMMUNITY_HEALTH_TOTALS[city.key];

// 社会保障与救助（区级）
const assistance = getDistrictAssistance(city.key, district.adcode);
const cityAssistance = CITY_ASSISTANCE_TOTALS[city.key];

// 住房保障体系（区级）
const housingSecurity = getDistrictHousingSecurity(city.key, district.adcode);
const cityHousingSecurity = CITY_HOUSING_SECURITY_TOTALS[city.key];

// 道路交通安全（区级）
const roadSafety = getDistrictRoadSafety(city.key, district.adcode);
const cityRoadSafety = CITY_ROAD_SAFETY_TOTALS[city.key];

// 环境卫生（区级）
const sanitation = getDistrictSanitation(city.key, district.adcode);
const citySanitation = CITY_SANITATION_TOTALS[city.key];

// 心理健康服务（区级）
const mentalHealth = getDistrictMentalHealth(city.key, district.adcode);
const cityMental = CITY_MENTAL_TOTALS[city.key];

// 法律服务体系（区级）
const legalService = getDistrictLegalService(city.key, district.adcode);
const cityLegal = CITY_LEGAL_TOTALS[city.key];

// 志愿服务与社会组织（区级）
const volunteer = getDistrictVolunteer(city.key, district.adcode);
const cityVolunteer = CITY_VOLUNTEER_TOTALS[city.key];

// 可再生能源与绿色设施（区级）
const renewable = getDistrictRenewable(city.key, district.adcode);
const cityRenewable = CITY_RENEWABLE_TOTALS[city.key];

// 数字生活与互联网服务（区级）
const digitalLife = getDistrictDigitalLife(city.key, district.adcode);
const cityDigitalLife = CITY_DIGITAL_LIFE_TOTALS[city.key];

// 农业与乡村振兴（区级）
const agriculture = getDistrictAgriculture(city.key, district.adcode);
const cityAgriculture = CITY_AGRICULTURE_TOTALS[city.key];
const empService = getDistrictEmploymentService(city.key, district.adcode);
const cityEmpService = CITY_EMP_SERVICE_TOTALS[city.key];
const disasterRisk = getDistrictDisasterRisk(city.key, district.adcode);
const cityDisaster = CITY_DISASTER_TOTALS[city.key];
const accessibility = getDistrictAccessibility(city.key, district.adcode);
const cityAccessibility = CITY_ACCESSIBILITY_TOTALS[city.key];
const library = getDistrictLibrary(city.key, district.adcode);
const cityLibrary = CITY_LIBRARY_TOTALS[city.key];
const funeral = getDistrictFuneral(city.key, district.adcode);
const cityFuneral = CITY_FUNERAL_TOTALS[city.key];
const govService = getDistrictGovService(city.key, district.adcode);
const cityGovService = CITY_GOV_SERVICE_TOTALS[city.key];
const youthActivity = getDistrictYouthActivity(city.key, district.adcode);
const cityYouth = CITY_YOUTH_TOTALS[city.key];
const massSports = getDistrictMassSports(city.key, district.adcode);
const cityMassSports = CITY_MASS_SPORTS_TOTALS[city.key];
const marriage = getDistrictMarriage(city.key, district.adcode);
const cityMarriage = CITY_MARRIAGE_TOTALS[city.key];
const childFriendly = getDistrictChildFriendly(city.key, district.adcode);
const cityChild = CITY_CHILD_TOTALS[city.key];
const urbanRenewal = getDistrictUrbanRenewal(city.key, district.adcode);
const cityRenewal = CITY_RENEWAL_TOTALS[city.key];
const culturalSvc = getDistrictCulturalService(city.key, district.adcode);
const cityCulturalSvc = CITY_CULTURAL_SVC_TOTALS[city.key];
const pharmacy = getDistrictPharmacy(city.key, district.adcode);
const cityPharmacy = CITY_PHARMACY_TOTALS[city.key];
const disability = getDistrictDisability(city.key, district.adcode);
const cityDisability = CITY_DISABILITY_TOTALS[city.key];
const financialSvc = getDistrictFinancialService(city.key, district.adcode);
const cityFinSvc = CITY_FIN_SVC_TOTALS[city.key];
const veteran = getDistrictVeteran(city.key, district.adcode);
const cityVeteran = CITY_VETERAN_TOTALS[city.key];
const canteen = getDistrictCanteen(city.key, district.adcode);
const cityCanteen = CITY_CANTEEN_TOTALS[city.key];
const wifi = getDistrictWifi(city.key, district.adcode);
const cityWifi = CITY_WIFI_TOTALS[city.key];
const culturalCons = getDistrictCulturalConsumption(city.key, district.adcode);
const cityCulturalCons = CITY_CULTURAL_CONS_TOTALS[city.key];
const foreignTrade = getDistrictForeignTrade(city.key, district.adcode);
const cityTrade = CITY_TRADE_TOTALS[city.key];
const waterFacility = getDistrictWaterFacility(city.key, district.adcode);
const cityWaterFac = CITY_WATER_FAC_TOTALS[city.key];

const radarSeries = [
  { name: district.name, color: '#0d9488', values: METRICS.map((m) => district.metrics[m.key].score) },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Place',
  name: `${city.name}${district.name}宜居度`,
  description: `${district.name} 的六维宜居度评分（综合 ${mine.composite.toFixed(0)} 分，${mine.grade} 级）。`,
  url: new URL(`/${city.key}/district/${code}`, Astro.site).href,
  containedInPlace: { '@type': 'AdministrativeArea', name: city.name },
};
---

<BaseLayout
  title={`${city.name}${district.name}宜居度评分`}
  description={`${district.name} 六维宜居度：综合 ${mine.composite.toFixed(0)} 分（${mine.grade} 级，${city.name}第 ${mine.rank} 名）。教育、医疗、交通、生活配套密度与人口数据，均为公开数据，来源可追溯。`}
  path={`/${city.key}/district/${code}`}
  keywords={[
    `${city.name}${district.name}宜居度`,
    `${district.name}适合居住吗`,
    `${city.name}${district.name}教育医疗`,
    `${city.name}${district.name}交通生活配套`,
    `${city.name}${district.name}人口密度`,
    `${city.name}哪个区好`,
    `${city.name}区县对比`,
    '宜居度评分',
  ]}
  jsonLd={jsonLd}
>
  <section class="container-page py-10 sm:py-14">
    <a href={`/${city.key}/`} class="text-sm text-ink-soft hover:text-accent">← 返回{city.name}排行榜</a>

    <div class="mt-4 grid gap-6 lg:grid-cols-[auto_1fr]">
      <div class="card flex flex-col items-center justify-center p-6">
        <GradeBadge grade={mine.grade} rank={mine.rank} size="lg" />
        <div class="mt-3 text-center">
          <div class="text-3xl font-bold text-accent">{mine.composite.toFixed(0)}</div>
          <div class="text-xs text-ink-soft">综合宜居度 /100</div>
        </div>
      </div>

      <div class="card p-6">
        <h1 class="text-3xl font-bold tracking-tight">{district.name}</h1>
        <p class="mt-2 text-sm text-ink-soft">{city.name} · 行政区代码 {district.adcode}</p>
        <div class="mt-4">
          <RadarChart client:visible axes={METRICS.map((m) => ({ label: m.shortLabel }))} series={radarSeries} size={220} />
        </div>
      </div>
    </div>

    {env && (
      <div class="mt-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
        🌿 {city.name}{env.year}年环境参考：PM2.5 年均 <strong>{env.pm25} μg/m³</strong>，AQI 优良率 <strong>{env.aqiGoodRate}%</strong>
        <span class="text-xs text-emerald-600">（市级数据，非区级评分维度）</span>
      </div>
    )}

    {(emp || green) && (
      <div class="mt-2 flex flex-wrap gap-2">
        {emp && (
          <div class="rounded-lg border border-blue-200 bg-blue-50 px-3 py-2 text-xs text-blue-800">
            💼 {city.name}{emp.year}年：城镇新增就业 <strong>{emp.newJobs}万人</strong>
            {emp.surveyUnemploymentRate && `，调查失业率 ${emp.surveyUnemploymentRate}%`}
          </div>
        )}
        {green && (
          <div class="rounded-lg border border-green-200 bg-green-50 px-3 py-2 text-xs text-green-800">
            🌳 {city.name}{green.year}年：
            {green.perCapitaParkArea && `人均公园绿地 ${green.perCapitaParkArea}㎡`}
            {green.parkCount && `，公园 ${green.parkCount}座`}
            {green.perCapitaSportsArea && `，人均体育场地 ${green.perCapitaSportsArea}㎡`}
          </div>
        )}
      </div>
    )}

    {housing && (
      <div class="mt-2 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
        🏠 {district.name}居住成本参考：二手房均价约 <strong>{housing.price.toLocaleString()} 元/㎡</strong>
        <span class="text-xs text-amber-600">（{housing.year}年 · {housing.source}，非评分维度）</span>
      </div>
    )}

    {culture && (
      <div class="mt-2 rounded-lg border border-purple-200 bg-purple-50 px-4 py-3 text-sm text-purple-800">
        🎭 {city.name}{culture.year}年文化设施：
