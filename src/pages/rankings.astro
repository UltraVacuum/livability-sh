---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CITIES } from '../data/cities';
import { getDistricts, METRICS, type MetricKey } from '../data/districts';
import { computeCity } from '../lib/scoring';

// Build cross-city ranking data for all metrics
interface RankRow {
  cityName: string;
  cityKey: string;
  districtName: string;
  adcode: string;
  rawValue: number;
  score: number;
  rank: number;
  unit: string;
}

interface DimensionRanking {
  metric: typeof METRICS[0];
  rows: RankRow[];
}

const dimensionRankings: DimensionRanking[] = METRICS.map((metric) => {
  const allRows: RankRow[] = [];
  for (const city of CITIES) {
    const scored = computeCity(getDistricts(city.key));
    for (const d of scored) {
      allRows.push({
        cityName: city.name,
        cityKey: city.key,
        districtName: d.name,
        adcode: d.adcode,
        rawValue: d.metrics[metric.key as MetricKey].rawValue,
        score: d.metrics[metric.key as MetricKey].score,
        rank: 0, // will set below
        unit: metric.unit,
      });
    }
  }
  // Sort by score desc and assign global rank
  allRows.sort((a, b) => b.score - a.score);
  allRows.forEach((r, i) => { r.rank = i + 1; });
  return { metric, rows: allRows };
});

// Featured dimensions: education, healthcare, economy (task requirement)
const featuredKeys: MetricKey[] = ['education', 'healthcare', 'economy'];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '全国区县宜居度排行榜',
  description: '上海、银川各区县教育、医疗、经济等多维度排名',
};

const pageTitle = '区县宜居度排行榜 · 教育/医疗/经济多维排名';
const pageDesc = '上海与银川全部区县按教育、医疗、经济等维度横向排名，CSS 可视化条形图直观展示各區实力，支持维度切换。基于公开数据的城市宜居度分析。';
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  path="/rankings"
  keywords={[
    '上海区排名',
    '区教育质量排名',
    '区医疗资源排名',
    '人均GDP排名',
    '区县排行榜',
    '城市宜居度排名',
    '哪个区教育好',
    '哪个区医疗好',
    '上海宜居度',
    '银川宜居度',
  ]}
  jsonLd={jsonLd}
>
  <section class="container-page py-10 sm:py-14">
    <a href="/" class="text-sm text-ink-soft hover:text-accent">← 返回首页</a>
    <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">区县宜居度排行榜</h1>
    <p class="mt-3 max-w-2xl text-ink-soft">
      上海 {CITIES.find(c => c.key === 'shanghai')?.name ?? '' }16区 + 银川6区县，按六个维度横向排名。
      切换维度查看不同视角下的区域实力排序。数据来源：高德POI密度 + 统计年鉴。
    </p>

    {/* Dimension switcher */}
    <div class="mt-8 flex flex-wrap gap-2" id="dim-switcher">
      {dimensionRankings.map((dr, idx) => (
        <button
          type="button"
          class={`dim-tab rounded-full border px-4 py-2 text-sm font-medium transition ${featuredKeys.includes(dr.metric.key as MetricKey) ? 'border-accent bg-accent-soft text-accent' : 'border-line bg-surface text-ink-soft hover:text-ink'}`}
          data-dim={dr.metric.key}
          data-idx={idx}
        >
          {dr.metric.label}
        </button>
      ))}
    </div>

    {/* Ranking tables */}
    {dimensionRankings.map((dr, idx) => {
      const isFeatured = featuredKeys.includes(dr.metric.key as MetricKey);
      const top10 = dr.rows.slice(0, 10);
      const maxScore = 100;
      return (
        <div
          class={`dim-panel mt-8 ${idx > 0 ? 'hidden' : ''}`}
          data-dim={dr.metric.key}
        >
          <div class="flex items-baseline justify-between">
            <h2 class="text-xl font-bold">{dr.metric.label}排行榜</h2>
            <span class="text-xs text-ink-soft">
              单位：{dr.metric.unit} · 共 {dr.rows.length} 个区县 · {dr.metric.real ? '✅ 真实数据' : '⚠️ 示例数据'}
            </span>
          </div>
          <p class="mt-1 text-sm text-ink-soft">{dr.metric.description}</p>

          {/* CSS Bar Chart Ranking Table */}
          <div class="card mt-6 overflow-hidden p-0">
            <div class="border-b border-line bg-surface-muted px-4 py-2.5 text-xs font-medium text-ink-soft">
              Top 10 — 按标准化评分排序
            </div>
            <div class="divide-y divide-line">
              {top10.map((row) => {
                const barWidth = (row.score / maxScore) * 100;
                const isTop3 = row.rank <= 3;
                const medal = row.rank === 1 ? '🥇' : row.rank === 2 ? '🥈' : row.rank === 3 ? '🥉' : '';
                return (
                  <div class="flex items-center gap-3 px-4 py-3 transition hover:bg-surface-muted">
                    <span class={`w-8 shrink-0 text-center text-lg font-bold ${isTop3 ? '' : 'text-ink-soft'}`}>
                      {medal || row.rank}
                    </span>
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2">
                        <a
                          href={`/${row.cityKey}/district/${row.adcode}`}
                          class="truncate font-medium text-ink hover:text-accent"
                        >
                          {row.districtName}
                        </a>
                        <span class="shrink-0 rounded-full bg-surface-muted px-2 py-0.5 text-[10px] text-ink-soft">
                          {row.cityName}
                        </span>
                      </div>
                      <div class="mt-1 flex items-center gap-2">
                        <span class="h-2 flex-1 overflow-hidden rounded-full bg-surface-muted">
                          <span
                            class="block h-full rounded-full transition-all duration-500"
                            style={`width:${barWidth}%; background: ${isTop3 ? 'linear-gradient(90deg, #0d9488, #14b8a6)' : '#0d9488'}`}
                          />
                        </span>
                      </div>
                    </div>
                    <div class="shrink-0 text-right">
                      <div class="font-bold text-ink">{row.score.toFixed(0)}</div>
                      <div class="text-[10px] text-ink-soft">{row.rawValue.toLocaleString()} {row.unit}</div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>

          {/* Full ranking for featured dimensions */}
          {isFeatured && dr.rows.length > 10 && (
            <details class="mt-4">
              <summary class="cursor-pointer text-sm font-medium text-accent hover:underline">
                查看全部 {dr.rows.length} 个区县排名
              </summary>
              <div class="card mt-3 overflow-x-auto p-0">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b border-line">
                      <th class="px-4 py-2.5 text-left text-xs font-medium text-ink-soft">排名</th>
                      <th class="px-4 py-2.5 text-left text-xs font-medium text-ink-soft">区县</th>
                      <th class="px-4 py-2.5 text-left text-xs font-medium text-ink-soft">城市</th>
                      <th class="px-4 py-2.5 text-right text-xs font-medium text-ink-soft">原始值</th>
                      <th class="px-4 py-2.5 text-right text-xs font-medium text-ink-soft">评分</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-line">
                    {dr.rows.map((row) => (
                      <tr class="transition hover:bg-surface-muted">
                        <td class="px-4 py-2 font-medium text-ink-soft">{row.rank}</td>
                        <td class="px-4 py-2">
                          <a href={`/${row.cityKey}/district/${row.adcode}`} class="font-medium text-ink hover:text-accent">
                            {row.districtName}
                          </a>
                        </td>
                        <td class="px-4 py-2 text-ink-soft">{row.cityName}</td>
                        <td class="px-4 py-2 text-right text-ink-soft">{row.rawValue.toLocaleString()} {row.unit}</td>
                        <td class="px-4 py-2 text-right font-semibold">{row.score.toFixed(0)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          )}

          {/* Per-city breakdown */}
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            {CITIES.map((city) => {
              const cityRows = dr.rows.filter(r => r.cityKey === city.key);
              const best = cityRows[0];
              const worst = cityRows[cityRows.length - 1];
              return (
                <div class="card p-5">
                  <h3 class="font-semibold text-ink">{city.name} · {dr.metric.label}</h3>
                  {best && (
                    <p class="mt-2 text-sm">
                      <span class="text-ink-soft">最强：</span>
                      <a href={`/${city.key}/district/${best.adcode}`} class="font-medium text-accent hover:underline">
                        {best.districtName}
                      </a>
                      <span class="text-ink-soft">（{best.score.toFixed(0)} 分）</span>
                    </p>
                  )}
                  {worst && worst !== best && (
                    <p class="mt-1 text-sm">
                      <span class="text-ink-soft">待提升：</span>
                      <a href={`/${city.key}/district/${worst.adcode}`} class="font-medium text-ink-soft hover:text-accent">
                        {worst.districtName}
                      </a>
                      <span class="text-ink-soft">（{worst.score.toFixed(0)} 分）</span>
                    </p>
                  )}
                  <a href={`/${city.key}/rankings/${dr.metric.key}`} class="mt-3 inline-block text-xs text-accent hover:underline">
                    查看{city.name}单维度详细排名 →
                  </a>
                </div>
              );
            })}
          </div>
        </div>
      );
    })}

    {/* Dimension switcher script */}
    <script is:inline>
      (function () {
        const tabs = document.querySelectorAll('.dim-tab');
        const panels = document.querySelectorAll('.dim-panel');
        tabs.forEach((tab) => {
          tab.addEventListener('click', function () {
            const dim = this.getAttribute('data-dim');
            tabs.forEach((t) => {
              t.classList.remove('border-accent', 'bg-accent-soft', 'text-accent');
              t.classList.add('border-line', 'bg-surface', 'text-ink-soft');
            });
            this.classList.remove('border-line', 'bg-surface', 'text-ink-soft');
            this.classList.add('border-accent', 'bg-accent-soft', 'text-accent');
            panels.forEach((p) => {
              if (p.getAttribute('data-dim') === dim) {
                p.classList.remove('hidden');
              } else {
                p.classList.add('hidden');
              }
            });
          });
        });
      })();
    </script>

    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/compare" class="rounded-xl bg-accent px-5 py-2.5 text-sm font-medium text-white transition hover:opacity-90">
        📊 去对比区县 →
      </a>
      <a href="/" class="rounded-xl border border-line bg-surface px-5 py-2.5 text-sm font-medium text-ink-soft transition hover:text-ink">
        回首页
      </a>
    </div>
  </section>
</BaseLayout>
