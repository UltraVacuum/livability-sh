---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CITIES } from '../data/cities';
import { getDistricts, METRICS, type MetricKey } from '../data/districts';
import { computeCity, rankWithWeights } from '../lib/scoring';
import { SITE } from '../consts';

const cards = CITIES.map((c) => {
  const d = computeCity(getDistricts(c.key));
  const top = rankWithWeights(d)[0];
  return { city: c, count: d.length, top };
});

// ── Data dashboard stats ──
const totalDistricts = CITIES.reduce((sum, c) => sum + getDistricts(c.key).length, 0);
const totalDimensions = METRICS.length;
const totalCities = CITIES.length;
const totalDataPoints = totalDistricts * totalDimensions;

// Average scores per city for radar comparison
const cityAverages = CITIES.map((c) => {
  const scored = computeCity(getDistricts(c.key));
  const avgs: Record<string, number> = {};
  for (const m of METRICS) {
    const scores = scored.map((d) => d.metrics[m.key as MetricKey].score);
    avgs[m.key] = scores.reduce((a: number, b: number) => a + b, 0) / (scores.length || 1);
  }
  return { city: c, avgs, districtCount: scored.length };
});

// Max average for radar scaling
const maxAvg = Math.max(...cityAverages.flatMap((ca) => Object.values(ca.avgs)));

// Data source counts
const realDimensions = METRICS.filter((m) => m.real).length;
const sampleDimensions = totalDimensions - realDimensions;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  alternateName: '城市宜居度对比',
  url: SITE.url,
  description: SITE.description,
  inLanguage: SITE.locale,
  // 站内搜索：让 Google 在搜索结果里展示 sitelinks search box
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: new URL(`/search?q={search_term_string}`, SITE.url).href,
    },
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout
  jsonLd={jsonLd}
  keywords={[
    '城市规划',
    '城市规划分析',
    '城市数据分析',
    '城市宜居度对比',
    '宜居城市',
    '区县宜居度排行榜',
    '哪个区最适合居住',
    '公开数据',
    '上海宜居度',
    '银川宜居度',
  ]}
>
  <section class="container-page py-12 sm:py-20">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="text-3xl font-bold tracking-tight sm:text-5xl">
        城市<span class="text-accent">宜居度</span>对比
      </h1>
      <p class="mt-4 text-base text-ink-soft sm:text-lg">
        选择城市 → 看各区县六维评分（经济、人口、教育、医疗、交通、生活），拖动权重实时重排，找到最适合你的区。
        人口与配套为真实公开数据，算法可解释。
      </p>
    </div>

    {/* ── 数据看板 ── */}
    <div class="mt-12 card overflow-hidden p-0">
      <div class="bg-gradient-to-r from-accent-soft to-surface-muted px-6 py-5 sm:px-8">
        <h2 class="text-lg font-bold text-ink">📈 数据看板</h2>
        <p class="mt-1 text-sm text-ink-soft">基于平台真实数据自动统计，实时反映覆盖规模</p>
      </div>
      <div class="grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-4">
        <div class="bg-surface p-6 text-center">
          <div class="text-3xl font-bold text-accent">{totalCities}</div>
          <div class="mt-1 text-xs text-ink-soft">已覆盖城市</div>
        </div>
        <div class="bg-surface p-6 text-center">
          <div class="text-3xl font-bold text-accent">{totalDistricts}</div>
          <div class="mt-1 text-xs text-ink-soft">区县总数</div>
        </div>
        <div class="bg-surface p-6 text-center">
          <div class="text-3xl font-bold text-accent">{totalDimensions}</div>
          <div class="mt-1 text-xs text-ink-soft">评分维度</div>
        </div>
        <div class="bg-surface p-6 text-center">
          <div class="text-3xl font-bold text-accent">{totalDataPoints.toLocaleString()}</div>
          <div class="mt-1 text-xs text-ink-soft">数据点</div>
        </div>
      </div>
      {/* Data coverage bar */}
      <div class="border-t border-line px-6 py-4 sm:px-8">
        <div class="flex items-center justify-between text-xs">
          <span class="text-ink-soft">数据来源比例</span>
          <span class="text-ink-soft">真实数据 {realDimensions}/{totalDimensions} 维度 ({Math.round(realDimensions / totalDimensions * 100)}%)</span>
        </div>
        <div class="mt-2 flex h-3 overflow-hidden rounded-full">
          <div class="h-full bg-grade-a" style={`width:${(realDimensions / totalDimensions) * 100}%`} title="真实公开数据" />
          {sampleDimensions > 0 && (
            <div class="h-full bg-grade-c" style={`width:${(sampleDimensions / totalDimensions) * 100}%`} title="估算/示例数据" />
          )}
        </div>
      </div>
    </div>

    {/* ── 城市维度雷达对比 (CSS) ── */}
    <div class="mt-8 grid gap-4 lg:grid-cols-2">
      {cityAverages.map((ca) => (
        <div class="card p-6">
          <h3 class="font-bold text-ink">{ca.city.name} · 六维平均分</h3>
          <p class="mt-0.5 text-xs text-ink-soft">{ca.districtCount} 个区县的维度均值</p>
          {/* CSS horizontal bar comparison */}
          <div class="mt-4 space-y-2">
            {METRICS.map((m) => {
              const val = ca.avgs[m.key];
              const barWidth = maxAvg > 0 ? (val / maxAvg) * 100 : 0;
              return (
                <div class="flex items-center gap-2 text-xs">
                  <span class="w-12 shrink-0 text-ink-soft">{m.shortLabel}</span>
                  <div class="h-5 flex-1 overflow-hidden rounded bg-surface-muted">
                    <div
                      class="flex h-full items-center justify-end rounded transition-all duration-700"
                      style={`width:${barWidth}%; background: linear-gradient(90deg, #0d9488, #14b8a6)`}
                    >
                      <span class="pr-2 text-[10px] font-bold text-white">{val.toFixed(1)}</span>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      ))}
    </div>

    <h2 class="mt-12 text-sm font-semibold uppercase tracking-wide text-ink-soft">选择城市</h2>
    <div class="mt-4 grid gap-5 sm:grid-cols-2">
      {
        cards.map(({ city, count, top }) => (
          <a href={`/${city.key}/`} class="card group block p-6 transition hover:-translate-y-0.5 hover:shadow-lg">
            <div class="flex items-center justify-between">
              <h3 class="text-2xl font-bold">{city.name}</h3>
              <span class="text-3xl opacity-40 transition group-hover:opacity-70">→</span>
            </div>
            <p class="mt-1 text-sm text-ink-soft">{city.blurb}</p>
            <div class="mt-4 flex items-center gap-4 text-sm">
              <span class="rounded-full bg-accent-soft px-3 py-1 text-xs font-medium text-accent">{count} 区县</span>
              {top && (
                <span class="text-ink-soft">
                  综合第一 <span class="font-semibold text-ink">{top.district.name}</span>（{top.grade}）
                </span>
              )}
            </div>
          </a>
        ))
      }
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-3">
      <div class="card p-5">
        <div class="text-2xl">📊</div>
        <h3 class="mt-2 font-semibold">六维评分</h3>
        <p class="mt-1 text-sm text-ink-soft">z-score 归一 + 加权综合，城市内百分位分级。</p>
      </div>
      <div class="card p-5">
        <div class="text-2xl">🎛️</div>
        <h3 class="mt-2 font-semibold">自定义权重</h3>
        <p class="mt-1 text-sm text-ink-soft">拖动滑块，地图与排行榜实时重排 —— 对你最宜居。</p>
      </div>
      <div class="card p-5">
        <div class="text-2xl">🔍</div>
        <h3 class="mt-2 font-semibold">来源透明</h3>
        <p class="mt-1 text-sm text-ink-soft">每项可溯源，算法公开。详见<a href="/methodology" class="text-accent hover:underline">评分方法</a>。</p>
      </div>
    </div>

    {/* ── 全局工具入口 ── */}
    <div class="mt-14 grid gap-4 sm:grid-cols-3">
      <a href="/explore" class="card group block p-6 transition hover:-translate-y-0.5 hover:shadow-lg">
        <div class="flex items-center justify-between">
          <div>
            <div class="text-2xl">🔬</div>
            <h2 class="mt-2 text-lg font-bold">维度深探</h2>
            <p class="mt-1 text-sm text-ink-soft">选择维度，深入分析跨城市区县排名分布与统计摘要</p>
          </div>
          <span class="text-2xl opacity-40 transition group-hover:opacity-70">→</span>
        </div>
      </a>
      <a href="/rankings" class="card group block p-6 transition hover:-translate-y-0.5 hover:shadow-lg">
        <div class="flex items-center justify-between">
          <div>
            <div class="text-2xl">🏆</div>
            <h2 class="mt-2 text-lg font-bold">区县排行榜</h2>
            <p class="mt-1 text-sm text-ink-soft">教育、医疗、经济等多维度横向排名，CSS 条形图可视化</p>
          </div>
          <span class="text-2xl opacity-40 transition group-hover:opacity-70">→</span>
        </div>
      </a>
      <a href="/compare" class="card group block p-6 transition hover:-translate-y-0.5 hover:shadow-lg">
        <div class="flex items-center justify-between">
          <div>
            <div class="text-2xl">📊</div>
            <h2 class="mt-2 text-lg font-bold">区县对比</h2>
            <p class="mt-1 text-sm text-ink-soft">选择两个区县，六维雷达图直观对比差异</p>
          </div>
          <span class="text-2xl opacity-40 transition group-hover:opacity-70">→</span>
        </div>
      </a>
    </div>

    {/* ── 全球对标入口 ── */}
    <div class="mt-8 card overflow-hidden p-0">
      <div class="bg-gradient-to-r from-blue-50 to-emerald-50 p-6 sm:p-8">
        <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h2 class="text-xl font-bold">🌍 全球城市对标</h2>
            <p class="mt-1 text-sm text-ink-soft">上海和银川 vs 纽约/伦敦/东京/新加坡——空气质量、GDP、绿地、安全等 8 维国际坐标系</p>
          </div>
          <a href="/global-benchmarks" class="shrink-0 rounded-xl bg-accent px-5 py-2.5 text-sm font-medium text-white transition hover:opacity-90">
            查看对比 →
          </a>
        </div>
      </div>
    </div>

    <div class="mx-auto mt-10 max-w-md text-center">
      <a href="/search" class="inline-flex items-center gap-2 rounded-xl border border-line bg-surface px-6 py-3 text-sm font-medium text-ink-soft transition hover:border-accent hover:text-accent">
        🔍 搜索区县
      </a>
    </div>
  </section>
</BaseLayout>
