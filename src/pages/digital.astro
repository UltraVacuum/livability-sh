---
import BaseLayout from '../layouts/BaseLayout.astro';
import DigitalScenarioTool from '../components/DigitalScenarioTool';
import { CITIES } from '../data/cities';
import { getDistricts } from '../data/districts';
import { getDigitalEconomy } from '../data/digitalEconomy';
import { CITY_SMART_TOTALS, smartCitySource } from '../data/smartCity';
import { getCityDigital } from '../data/digitalInfra';
import { CENSUS, SH_OFFICIAL_2024 } from '../data/census';
import { BEIJING_DISTRICTS } from '../data/beijing';

const CITY_COLORS: Record<string, string> = {
  shanghai: '#0d9488',
  beijing: '#2563eb',
  yinchuan: '#7c3aed',
};

function average(values: number[]): number {
  if (values.length === 0) return 0;
  return values.reduce((sum, value) => sum + value, 0) / values.length;
}

interface CityDigitalProfile {
  key: string;
  name: string;
  color: string;
  districtCount: number;
  populationWan: number;
  smartAverage: number;
  districtDigitalAverage: number;
  officialDigitalShare: number | undefined;
  coreIndustryEmployees: number;
  digitalCompanies: number;
  fiveGStations: number | undefined;
  mobileUsers: number | undefined;
  fiveGPenetration: number | undefined;
  smartLeader: { name: string; value: number };
  digitalLeader: { name: string; value: number };
  smartTotals: (typeof CITY_SMART_TOTALS)[string] | undefined;
  digitalInfra: ReturnType<typeof getCityDigital>;
  source: string;
}

const cityProfiles: CityDigitalProfile[] = CITIES.map((city) => {
  const districts = getDistricts(city.key);
  const smartTotals = CITY_SMART_TOTALS[city.key];
  const digitalInfra = getCityDigital(city.key);
  const districtRows = districts.map((district) => ({
    district,
    digital: getDigitalEconomy(district.adcode),
  }));

  const smartSorted = [...districts].sort((a, b) => b.values.smart - a.values.smart);
  const digitalSorted = [...districts].sort((a, b) => b.values.digital - a.values.digital);
  const populationWan =
    city.key === 'shanghai'
      ? Object.values(SH_OFFICIAL_2024).reduce((sum, district) => sum + district.pop_wan, 0)
      : city.key === 'beijing'
        ? BEIJING_DISTRICTS.reduce((sum, district) => sum + district.popWan, 0)
        : Object.values(CENSUS[city.key]?.pop ?? {}).reduce((sum, population) => sum + population, 0) / 10000;

  return {
    key: city.key,
    name: city.name,
    color: CITY_COLORS[city.key] ?? '#0d9488',
    districtCount: districts.length,
    populationWan: +populationWan.toFixed(2),
    smartAverage: +average(districts.map((d) => d.values.smart)).toFixed(1),
    districtDigitalAverage: +average(districts.map((d) => d.values.digital)).toFixed(1),
    officialDigitalShare: digitalInfra?.digitalGdpRatio,
    coreIndustryEmployees: districtRows.reduce(
      (sum, row) => sum + (row.digital?.coreIndustryEmployees ?? 0),
      0,
    ),
    digitalCompanies: districtRows.reduce(
      (sum, row) => sum + (row.digital?.digitalCompanies ?? 0),
      0,
    ),
    fiveGStations: digitalInfra?.total5GStations,
    mobileUsers: digitalInfra?.mobileUsers,
    fiveGPenetration: digitalInfra?.g5Penetration,
    smartLeader: {
      name: smartSorted[0]?.name ?? '—',
      value: smartSorted[0]?.values.smart ?? 0,
    },
    digitalLeader: {
      name: digitalSorted[0]?.name ?? '—',
      value: digitalSorted[0]?.values.digital ?? 0,
    },
    smartTotals,
    digitalInfra,
    source: smartCitySource(city.key),
  };
});

const metricDefinitions: Array<{
  key: string;
  label: string;
  totalDescription: string;
  perCapitaDescription: string;
  unit: string;
  perCapitaUnit: string;
  populationScaled: boolean;
}> = [
  {
    key: 'smartAverage',
    label: '智慧城市区均指数',
    totalDescription: '区县智慧城市指数的算术平均值（0-100）',
    perCapitaDescription: '指数已经是强度指标，三种口径下保持不变',
    unit: '分',
    perCapitaUnit: '分',
    populationScaled: false,
  },
  {
    key: 'officialDigitalShare',
    label: '数字经济核心产业占GDP',
    totalDescription: '市级官方口径；北京为数字经济核心产业，非数字经济全口径',
    perCapitaDescription: '占比是强度指标，不按人口均摊；仍需注意各市统计口径差异',
    unit: '%',
    perCapitaUnit: '%',
    populationScaled: false,
  },
  {
    key: 'coreIndustryEmployees',
    label: '数字经济核心就业',
    totalDescription: '区级数字经济核心产业就业估算汇总',
    perCapitaDescription: '核心就业 ÷ 常住人口，表示每万人拥有的数字经济核心就业',
    unit: '人',
    perCapitaUnit: '人/万人',
    populationScaled: true,
  },
  {
    key: 'digitalCompanies',
    label: '数字经济企业',
    totalDescription: '区级数字经济企业估算汇总',
    perCapitaDescription: '企业数 ÷ 常住人口，表示每万人拥有的数字经济企业',
    unit: '家',
    perCapitaUnit: '家/万人',
    populationScaled: true,
  },
  {
    key: 'fiveGStations',
    label: '5G基站',
    totalDescription: '市级通信/统计公报总量',
    perCapitaDescription: '基站数 ÷ 常住人口，表示每万人拥有的5G基站',
    unit: '个',
    perCapitaUnit: '个/万人',
    populationScaled: true,
  },
];

const scenarioMetrics = metricDefinitions.map((metric) => ({
  key: metric.key as
    | 'smartAverage'
    | 'officialDigitalShare'
    | 'coreIndustryEmployees'
    | 'digitalCompanies'
    | 'fiveGStations',
  label: metric.label,
  totalDescription: metric.totalDescription,
  perCapitaDescription: metric.perCapitaDescription,
  totalUnit: metric.unit,
  perCapitaUnit: metric.perCapitaUnit,
  populationScaled: metric.populationScaled,
}));

const scenarioCities = cityProfiles.map((profile) => ({
  key: profile.key,
  name: profile.name,
  color: profile.color,
  populationWan: profile.populationWan,
  values: {
    smartAverage: profile.smartAverage,
    officialDigitalShare: profile.officialDigitalShare,
    coreIndustryEmployees: profile.coreIndustryEmployees,
    digitalCompanies: profile.digitalCompanies,
    fiveGStations: profile.fiveGStations,
  },
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: '上海、北京、银川智慧城市与数字经济横向对比',
  description:
    '三城智慧城市指数、数字经济核心产业、核心就业、企业数量与5G基建横向对比，数据来自市级统计公报、通信行业公报与区级公开数据估算。',
  creator: { '@type': 'Organization', name: '宜居度' },
  keywords: ['智慧城市对比', '数字经济对比', '北京数字经济', '上海数字经济', '银川数字经济', '5G基站'],
};

const pageTitle = '智慧城市与数字经济横向对比 · 上海/北京/银川';
const pageDesc =
  '上海、北京、银川三城智慧城市指数、数字经济核心产业占GDP、核心就业、企业与5G基建横向对比，支持跨城市洞察数字治理与产业活力差异。';
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  path="/digital"
  keywords={['智慧城市对比', '数字经济对比', '城市数字化', '5G基站对比', '上海智慧城市', '北京数字经济', '银川数字经济']}
  jsonLd={jsonLd}
>
  <section class="container-page py-10 sm:py-14">
    <a href="/" class="text-sm text-ink-soft hover:text-accent">← 返回首页</a>
    <div class="mt-4 flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="rounded-full bg-accent-soft px-3 py-1 text-xs font-medium text-accent">3 城横向对比</span>
        <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">智慧城市 × 数字经济</h1>
        <p class="mt-3 max-w-3xl text-ink-soft">
          城市页的智慧/数字维度只做城市内区县对比；本页把上海、北京、银川放在同一张表上，比较市级官方口径与区级汇总估算。
        </p>
      </div>
      <div class="rounded-xl border border-line bg-surface px-5 py-4 text-sm text-ink-soft">
        <div><strong class="text-ink">{cityProfiles.length}</strong> 个城市</div>
        <div><strong class="text-ink">{cityProfiles.reduce((sum, c) => sum + c.districtCount, 0)}</strong> 个区县</div>
        <div><strong class="text-ink">2</strong> 个横向维度族</div>
      </div>
    </div>

    <div class="mt-8 grid gap-4 lg:grid-cols-3">
      {cityProfiles.map((profile) => (
        <article class="card p-5">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-lg font-bold text-ink">{profile.name}</h2>
              <p class="text-xs text-ink-soft">
                {profile.districtCount} 个区县 · 常住人口 {profile.populationWan.toFixed(2)} 万 · 区均智慧指数 {profile.smartAverage}
              </p>
            </div>
            <span class="h-3 w-12 rounded-full" style={`background:${profile.color}`} />
          </div>

          <dl class="mt-4 grid grid-cols-2 gap-3 text-sm">
            <div class="rounded-lg bg-surface-muted p-3">
              <dt class="text-xs text-ink-soft">市级数字核心占比</dt>
              <dd class="mt-1 text-lg font-bold text-ink">{profile.officialDigitalShare ? `${profile.officialDigitalShare}%` : '—'}</dd>
            </div>
            <div class="rounded-lg bg-surface-muted p-3">
              <dt class="text-xs text-ink-soft">区均数字占比</dt>
              <dd class="mt-1 text-lg font-bold text-ink">{profile.districtDigitalAverage}%</dd>
            </div>
            <div class="rounded-lg bg-surface-muted p-3">
              <dt class="text-xs text-ink-soft">智慧领跑区</dt>
              <dd class="mt-1 font-semibold text-ink">{profile.smartLeader.name}</dd>
              <dd class="text-[10px] text-ink-soft">{profile.smartLeader.value} 分</dd>
            </div>
            <div class="rounded-lg bg-surface-muted p-3">
              <dt class="text-xs text-ink-soft">数字领跑区</dt>
              <dd class="mt-1 font-semibold text-ink">{profile.digitalLeader.name}</dd>
              <dd class="text-[10px] text-ink-soft">{profile.digitalLeader.value}%</dd>
            </div>
          </dl>

          {profile.smartTotals && (
            <p class="mt-4 text-xs leading-relaxed text-ink-soft">
              智慧政务：{profile.smartTotals.smartGovPlatform} 接入
              <strong class="text-ink">{profile.smartTotals.smartGovServices.toLocaleString('zh-CN')}</strong> 项服务，
              网办率 <strong class="text-ink">{profile.smartTotals.smartGovRate}%</strong>；
              5G渗透率 {profile.fiveGPenetration ? `${profile.fiveGPenetration}%` : '—'}
            </p>
          )}
        </article>
      ))}
    </div>

    <div class="mt-8">
      <DigitalScenarioTool client:load metrics={scenarioMetrics} cities={scenarioCities} />
    </div>

    <div class="mt-8 grid gap-4 lg:grid-cols-3">
      {cityProfiles.map((profile) => (
        <div class="card p-5 text-sm">
          <h3 class="font-semibold text-ink">{profile.name}数据口径</h3>
          <ul class="mt-3 space-y-2 text-xs leading-relaxed text-ink-soft">
            <li>智慧城市：{profile.source || '公开运营数据与区级估算'}</li>
            {profile.digitalInfra && (
              <li>
                数字基建：<a href={profile.digitalInfra.sourceUrl} class="text-accent hover:underline">{profile.digitalInfra.source}</a>
              </li>
            )}
            <li>区级数字就业/企业：digitalEconomy.ts，按产业园区、企业与普查公开数据分配估算</li>
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/correlation" class="rounded-xl bg-accent px-5 py-2.5 text-sm font-medium text-white transition hover:opacity-90">🔗 查看8维相关性矩阵</a>
      <a href="/rankings" class="rounded-xl border border-line bg-surface px-5 py-2.5 text-sm font-medium text-ink-soft transition hover:text-ink">🏆 区县排行榜</a>
      <a href="/methodology" class="rounded-xl border border-line bg-surface px-5 py-2.5 text-sm font-medium text-ink-soft transition hover:text-ink">评分方法</a>
    </div>
  </section>
</BaseLayout>
